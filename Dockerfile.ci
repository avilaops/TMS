# Standalone construido no runner Linux e aprovado por checks.
# Debian preserva a libc dos binarios nativos usados no runner.
ARG NODE_IMAGE=mirror.gcr.io/library/node:22-bookworm-slim
FROM ${NODE_IMAGE}
WORKDIR /app
ARG GIT_SHA
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    GIT_SHA=$GIT_SHA
COPY --chown=node:node . ./
USER node
EXPOSE 3000
CMD ["node", "server.js"]
