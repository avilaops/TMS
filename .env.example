# Copie para .env (desenvolvimento) ou /opt/tms-avilaops-com/.env (produção) e preencha.
# Nunca commite o arquivo preenchido.

# Postgres. Em desenvolvimento, o do docker-compose.dev.yml. Em produção, o
# PostgreSQL do servidor: postgresql://tms_avilaops_com:<senha>@host.docker.internal:5432/tms_avilaops_com?schema=public
DATABASE_URL="postgresql://tms:tms@127.0.0.1:5436/tms?schema=public"

# NextAuth: URL pública do sistema (https://tms.avilaops.com em produção) e segredo para assinar o JWT (openssl rand -base64 32).
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=

# Seed do administrador pela linha de comando (prisma/seed.ts).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Administrador"

# Seed pela rota POST /api/seed (só em desenvolvimento, header x-seed-secret).
SEED_SECRET=
SEED_ADMIN_PASSWORD=
