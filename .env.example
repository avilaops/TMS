# Copie para .env (desenvolvimento) ou /opt/tms-avilaops-com/.env (produção) e preencha.
# Nunca commite o arquivo preenchido.

# Postgres. Em desenvolvimento, o do docker-compose.dev.yml. Em produção, o
# PostgreSQL do servidor: postgresql://tms_avilaops_com:<senha>@host.docker.internal:5432/tms_avilaops_com?schema=public
DATABASE_URL="postgresql://tms:tms@127.0.0.1:5436/tms?schema=public"

# NextAuth: URL pública do sistema (https://tms.avilaops.com em produção) e segredo para assinar o JWT (openssl rand -base64 32).
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=

# Empresa (tenant) das rotas públicas de cotação e lead quando a requisição não
# informa `empresa`: o slug da transportadora dona do site que as chama.
TMS_EMPRESA_PADRAO=

# DANFE, DACTE e DAMDFE em PDF: o serviço fiscal da casa, alcançado pelo MCP
# único da empresa. Sem FISCAL_MCP_URL o recurso fica desligado e o botão não
# aparece. O token é o de serviço do TMS no MCP único ("Authorization: Bearer"),
# que só abre as ferramentas fiscais.
# FISCAL_MCP_URL="https://mcp.avilaops.com/mcp"
# FISCAL_MCP_TOKEN=
# FISCAL_MCP_TIMEOUT_MS=20000

# Responsável técnico do CT-e e do MDF-e (grupo infRespTec): não tem variável.
# Vem do cadastro da empresa em Empresa → Fiscal (CNPJ, telefone, contato e
# e-mail). Só o código de segurança, abaixo, fica no servidor.

# Código de segurança do responsável técnico (CSRT), opcional: só preencha se
# o fisco forneceu um CSRT à desenvolvedora. Com as DUAS variáveis, o grupo
# infRespTec ganha o idCSRT e o hashCSRT (Base64 do SHA-1 de CSRT + chave de
# acesso do documento, como os manuais do CT-e e do MDF-e definem). Sem elas,
# ou só com uma, o grupo vai sem os dois campos, como sempre foi. As regras que
# os exigem (CT-e: rejeição 868; MDF-e: 721) são facultativas e estão como
# "implementação futura" nos manuais.
#   RESPTEC_CSRT_ID  identificador do CSRT (número de 1 a 3 dígitos; "7" vira "007")
#   RESPTEC_CSRT     o CSRT. É SEGREDO: não vai para o XML nem para o log,
#                    só o hash calculado com a chave de cada documento.
# RESPTEC_CSRT_ID=
# RESPTEC_CSRT=

# Notificações push no navegador (Web Push). Sem as três variáveis o push fica
# desligado e só o sininho funciona. Gere o par de chaves uma vez com
#   npx web-push generate-vapid-keys
# e guarde: trocar as chaves desliga o push de todos os aparelhos já inscritos
# (cada pessoa precisa ativar de novo). VAPID_SUBJECT é o contato de quem opera
# o sistema, que os serviços de push dos navegadores exigem (mailto: ou https://).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT="mailto:suporte@avilaops.com"

# Cobrança pelo Mercado Pago (Pix dinâmico e boleto com baixa automática).
# TMS_CHAVE_DE_DADOS protege (AES-256-GCM) as credenciais que cada empresa
# cadastra em Empresa > Cobrança. Sem ela, ou com menos de 32 caracteres, o
# recurso fica desligado. Gere uma vez com
#   openssl rand -base64 48
# e guarde: trocar a chave torna ilegíveis as credenciais já gravadas (cada
# empresa precisa cadastrar de novo).
# TMS_CHAVE_DE_DADOS=
# Endereço da API do Mercado Pago. Só mude em teste (servidor local que a imita).
# MERCADO_PAGO_API="https://api.mercadopago.com"

# Mapa, endereço e GPS (OpenStreetMap; nenhum serviço pago).
# GEO_CONTATO liga a localização dos endereços de entrega pelo Nominatim: é o
# e-mail (ou site) de quem responde pelo uso, enviado no User-Agent, como a
# política do serviço exige. Sem ela nenhum endereço é consultado e a ordem das
# entregas segue pelo centro da cidade.
# GEO_CONTATO="suporte@avilaops.com"
# Servidor do Nominatim. Padrão: o público (no máximo 1 consulta por segundo,
# que o sistema respeita). Troque por uma instância própria se o volume crescer.
# GEO_URL="https://nominatim.openstreetmap.org"
# Servidor OSRM PRÓPRIO para a distância por estrada na ordem sugerida. Sem ela
# a distância é em linha reta. Não use o servidor de demonstração público
# (router.project-osrm.org): a política dele proíbe produção, e o sistema o recusa.
# ROTA_URL="http://osrm:5000"
# Blocos de imagem do mapa (https, com {z}, {x} e {y}). Padrão: os do
# OpenStreetMap. É lida na hora do build, como toda variável NEXT_PUBLIC_.
# NEXT_PUBLIC_MAPA_TILES="https://tile.openstreetmap.org/{z}/{x}/{y}.png"

# Seed pela linha de comando (prisma/seed.ts): cria a empresa, se faltar, e o
# administrador dentro dela.
TENANT_SLUG=
TENANT_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Administrador"

# Seed pela rota POST /api/seed (só em desenvolvimento, header x-seed-secret).
SEED_SECRET=
SEED_ADMIN_PASSWORD=

# Login pelo OIDC do auth.avilaops.com. O segredo é o mesmo valor de
# OIDC_SEGREDO_TMS no .env do auth. AVILAOPS_ISSUER só muda para apontar para
# outro auth em desenvolvimento.
AVILAOPS_CLIENT_ID="tms"
AVILAOPS_CLIENT_SECRET=
# AVILAOPS_ISSUER="https://auth.avilaops.com"
