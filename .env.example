# Copie para .env (desenvolvimento) ou /opt/mello/.env (produção) e preencha.
# Nunca commite o arquivo preenchido.

# Postgres. Em produção o docker-compose monta esta URL a partir de DB_PASSWORD.
DATABASE_URL="postgresql://mello:senha@localhost:5432/mello?schema=public"
DB_PASSWORD=

# NextAuth: URL pública do sistema (https://tms.avilaops.com em produção) e segredo para assinar o JWT (openssl rand -base64 32).
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=

# Seed do administrador pela linha de comando (prisma/seed.ts).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Administrador"

# Seed pela rota POST /api/seed (só em desenvolvimento, header x-seed-secret).
SEED_SECRET=
SEED_ADMIN_PASSWORD=
