generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Perfis de acesso. O que cada um pode fazer está em src/lib/permissoes.ts.
// Valor novo entra sempre no fim: é como o `ALTER TYPE ... ADD VALUE` o grava.
enum Role {
  ADMIN
  OPERATION
  DRIVER
  CLIENT
  DIRECTOR
  FINANCE
  COMMERCIAL
  EXPEDITION
  WAREHOUSE
}

// ---------------------------------------------------------------------------
// Multi-tenant
//
// Cada transportadora que usa o sistema e um Tenant. Toda tabela de negocio
// carrega `tenantId`, e quem separa uma empresa da outra e o proprio Postgres:
// as politicas de seguranca por linha (prisma/sql/010-rls.sql) so mostram as
// linhas do tenant gravado em `app.tenant_id` na transacao. O codigo nao
// preenche `tenantId` na mao: o valor padrao da coluna le essa mesma variavel,
// e sem ela o INSERT falha. Ver src/lib/prisma.ts.
// ---------------------------------------------------------------------------
model Tenant {
  id        String   @id @default(uuid())
  // Identificador curto e estavel (URL, integracoes). So letras minusculas, numeros e hifen.
  slug      String   @unique
  name      String
  cnpj      String?  @unique
  // Símbolo da empresa: data URL de imagem pequena. Nulo = símbolo padrão. Ver src/lib/empresa.ts.
  logo      String?  @db.Text
  active    Boolean  @default(true)
  // Encargos sugeridos na baixa de um título vencido: multa (% do valor, uma
  // vez) e juros (% ao mês, proporcional aos dias de atraso). Ver src/lib/cobranca.ts.
  lateFinePct     Float @default(2)
  lateInterestPct Float @default(1)
  // Recebimento por Pix (estático, sem banco): a chave da transportadora e o
  // recebedor que vão no "Pix Copia e Cola" da fatura. Tudo nulo = sem Pix.
  // `pixKeyType`: CPF, CNPJ, EMAIL, TELEFONE, ALEATORIA. Ver src/lib/pix.ts.
  pixKeyType      String?
  pixKey          String?
  pixName         String?
  pixCity         String?
  // O que o comprovante de entrega exige na baixa do motorista: LIVRE (foto e
  // assinatura opcionais), ECOMMERCE (foto da carga no local) ou B2B (foto do
  // canhoto assinado). Ver src/lib/comprovantes.ts.
  podProfile      String @default("LIVRE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  clients        Client[]
  drivers        Driver[]
  vehicles       Vehicle[]
  collections    Collection[]
  statusHistory  CollectionStatusHistory[]
  manifests      Manifest[]
  transactions   FinancialTransaction[]
  maintenances   Maintenance[]
  proofs         ProofOfDelivery[]
  quoteLeads     QuoteLead[]
  freightTables  FreightTable[]
  invoices       Invoice[]
  freightCities  FreightTableCity[]
  articles       Article[]
  socialPosts    SocialPost[]
  contentMetrics ContentMetric[]
  webhook        Webhook?
  outboxEvents   OutboxEvent[]
  fuelings       Fueling[]
  vehicleDocuments VehicleDocument[]
  tires          Tire[]
  vehicleChecklists VehicleChecklist[]
  occurrences    Occurrence[]
  occurrenceMessages OccurrenceMessage[]
  warehouseLocations WarehouseLocation[]
  collectionVolumes  CollectionVolume[]
  warehouseReceipts  WarehouseReceipt[]
  fiscalDocuments    FiscalDocument[]
  auditLogs          AuditLog[]
  helpers            Helper[]
  absences           Absence[]
  crewAdvances       CrewAdvance[]
  tripExpenses       TripExpense[]
  clientReceivers    ClientReceiver[]
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
  bankStatementLines BankStatementLine[]
  paymentGateway     PaymentGateway?
  paymentCharges     PaymentCharge[]
  tripPositions      TripPosition[]
  fiscalIssuer       FiscalIssuer?
  cteNumberings      CteNumbering[]
  ctes               Cte[]
  proofPhotos        ProofPhoto[]
  proofRejections    ProofRejection[]
  deliveryAttempts   DeliveryAttempt[]
  mdfeNumberings     MdfeNumbering[]
  mdfes              Mdfe[]
  mdfeEvents         MdfeEvent[]
}

model User {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id        String   @id @default(uuid())
  name      String
  email     String
  password  String
  role      Role     @default(CLIENT)
  clientId  String?  // Empresa que este usuário representa (obrigatório na prática quando role = CLIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // O que aconteceu com o convite por e-mail pedido ao login único
  // (ENVIADO | FALHOU | PENDENTE), o motivo e quando. O endereço de criar a
  // senha nunca é guardado. Ver src/lib/acessos.ts.
  inviteStatus String?
  inviteDetail String?
  inviteAt     DateTime?

  // Relations
  driver    Driver?
  client    Client?  @relation(fields: [clientId], references: [id])
  statusChanges CollectionStatusHistory[]
  proofsReviewed ProofOfDelivery[]
  proofRejections ProofRejection[]
  vehicleChecklists VehicleChecklist[]
  occurrencesOpened   Occurrence[] @relation("OccurrenceOpenedBy")
  occurrencesAssigned Occurrence[] @relation("OccurrenceAssignee")
  occurrenceMessages  OccurrenceMessage[]
  volumesChecked      CollectionVolume[]
  warehouseReceipts   WarehouseReceipt[]
  fiscalDocuments     FiscalDocument[]
  auditLogs           AuditLog[]
  tripExpensesCreated  TripExpense[] @relation("TripExpenseCreatedBy")
  tripExpensesReviewed TripExpense[] @relation("TripExpenseReviewedBy")
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  ctesIssued           Cte[]
  mdfesIssued          Mdfe[]
  mdfeEventsCreated    MdfeEvent[]

  @@index([clientId])

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, email])
}

model Client {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id              String   @id @default(uuid())
  companyName     String   // Razão social
  tradeName       String?  // Nome fantasia
  cnpj            String
  ie              String?
  contactName     String?
  email           String?
  phone           String?
  address         String?
  paymentCondition String?
  creditLimit     Float?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  collections     Collection[]
  users           User[]
  transactions    FinancialTransaction[]

  invoices        Invoice[]
  occurrences     Occurrence[]
  receivers       ClientReceiver[]

  // Tabela de frete negociada com este cliente. Sem ela vale a padrão da transportadora.
  freightTableId  String?
  freightTable    FreightTable? @relation(fields: [freightTableId], references: [id], onDelete: SetNull)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, cnpj])
  @@index([freightTableId])
}

// ---------------------------------------------------------------------------
// Tabelas de frete
//
// Uma tabela tem as regras gerais (peso coberto pelo frete mínimo, valor do kg
// excedente, cubagem, limite de nota) e uma linha por cidade atendida, com o
// frete mínimo e o prazo de lá. A transportadora tem uma tabela padrão
// (`isDefault`) e pode ter tabelas negociadas, ligadas a clientes. Quem faz a
// conta é `calcularFrete` (src/lib/frete.ts).
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Faturamento
//
// A fatura cobra de um cliente o frete de cargas já entregues. O total é a soma
// dos fretes no momento da emissão e não muda depois. Emitir a fatura cria o
// lançamento a receber no financeiro (FinancialTransaction.invoiceId), que é o
// que o cliente vê no portal; pagar e cancelar andam juntos nos dois.
// ---------------------------------------------------------------------------
model Invoice {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id        String    @id @default(uuid())
  number    Int       // sequencial por empresa
  clientId  String
  status    String    @default("OPEN") // OPEN, PAID, CANCELLED
  total     Float
  dueDate   DateTime
  issuedAt  DateTime  @default(now())
  paidAt    DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  client      Client       @relation(fields: [clientId], references: [id])
  collections Collection[]
  transaction FinancialTransaction?
  charges     PaymentCharge[]

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, number])
  @@index([clientId])
}

// Destinatário frequente de um cliente: ele cadastra pelo portal e escolhe ao
// pedir coleta. Cada cliente só enxerga os seus (filtro por `clientId`).
model ClientReceiver {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String   @id @default(uuid())
  clientId    String
  name        String
  document    String?  // CNPJ ou CPF, só dígitos
  city        String   // cidade-UF, como vai no destino da coleta
  address     String?
  contactName String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([tenantId, clientId])
}

model FreightTable {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id               String    @id @default(uuid())
  name             String
  active           Boolean   @default(true)
  // A tabela usada quando o cliente não tem uma própria. No máximo uma por
  // empresa: a rota desmarca a anterior na mesma transação.
  isDefault        Boolean   @default(false)
  validFrom        DateTime?
  validTo          DateTime?

  includedWeightKg Float     @default(0) // peso coberto pelo frete mínimo da cidade
  excessPerKg      Float     @default(0) // R$ por kg acima do peso coberto
  cubageFactor     Float?    // kg por m³; nulo = não cubar
  invoiceLimit     Float?    // valor de nota coberto pelo frete; nulo = sem limite
  adValoremPct     Float?    // % sobre o que passa do limite; nulo = consultar o comercial
  maxVolumes       Int?      // acima disso a cotação sai com aviso
  redeliveryPct    Float?    // reentrega, % do frete original
  returnPct        Float?    // devolução, % do frete original
  notes            String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  cities           FreightTableCity[]
  clients          Client[]
  collections      Collection[]

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, name])
}

model FreightTableCity {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id            String   @id @default(uuid())
  tableId       String
  city          String   // como a transportadora escreveu
  cityKey       String   // sem acento, caixa nem pontuação: é por aqui que a cotação acha a cidade
  minimum       Float    // frete mínimo para esta cidade
  deadlineHours Int      @default(24)
  dedicated     Boolean  @default(false) // só com veículo dedicado: a cotação avisa

  table         FreightTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tableId, cityKey])
}

model Driver {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id        String   @id @default(uuid())
  userId    String   @unique
  cpf       String
  cnh       String
  cnhExpiry DateTime
  category  String
  phone     String?
  active    Boolean  @default(true)
  // Percentual do frete entregue que vira comissão. Nulo = sem comissão. Só o
  // administrador lê e altera (src/lib/equipe.ts).
  commissionPct Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  user      User      @relation(fields: [userId], references: [id])
  vehicles  Vehicle[]
  manifests Manifest[]
  collections Collection[]
  fuelings  Fueling[]
  absences  Absence[]
  advances  CrewAdvance[]

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, cpf])
}

model Vehicle {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id           String   @id @default(uuid())
  plate        String
  model        String
  type         String
  capacity     Float?
  maxWeight    Float?
  year         Int?
  driverId     String?
  status       String   @default("AVAILABLE") // AVAILABLE, ON_ROUTE, MAINTENANCE
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // O que o MDF-e pede do veículo (grupos veicTracao e veicReboque do modal
  // rodoviário), tudo opcional no cadastro: a emissão lista o que falta
  // (src/lib/mdfe/preparar.ts). A capacidade em kg é `capacity`.
  renavam      String?  // 9 a 11 dígitos
  tareKg       Int?     // tara, em kg
  wheelType    String?  // tpRod: 01 truck, 02 toco, 03 cavalo mecânico, 04 van, 05 utilitário, 06 outros
  bodyType     String?  // tpCar: 00 não aplicável, 01 aberta, 02 fechada/baú, 03 graneleira, 04 porta-contêiner, 05 sider
  licenseState String?  // UF em que o veículo está licenciado
  // Proprietário, só quando o veículo NÃO é da empresa emitente (grupo `prop`).
  ownerTaxId   String?  // CPF ou CNPJ, sem pontuação
  ownerName    String?
  ownerRntrc   String?  // 8 dígitos
  ownerIe      String?  // só dígitos, "ISENTO" ou vazio
  ownerState   String?
  ownerType    String?  // tpProp: 0 TAC agregado, 1 TAC independente, 2 outros

  // Relations
  driver       Driver?  @relation(fields: [driverId], references: [id])
  manifests    Manifest[]
  maintenances Maintenance[]
  fuelings     Fueling[]
  documents    VehicleDocument[]
  tires        Tire[]
  checklists   VehicleChecklist[]

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, plate])
}

model Collection {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String   @id @default(uuid())
  clientId    String
  sender      String
  receiver    String
  origin      String
  destination String
  volumes     Int
  weight      Float
  invoiceKey  String?
  invoiceValue Float?
  driverId    String?
  manifestId  String?
  // Ordem desta entrega na viagem (1, 2, 3...). Nulo = sem ordem definida: vai
  // para o fim, pela data de criação. Volta a nulo quando a carga sai da viagem.
  manifestSequence Int?
  status      String   @default("PENDING") // PENDING, CONFIRMED, COLLECTED, ROUTE, DELIVERED

  // Frete desta carga. Calculado pela tabela de frete quando a coleta nasce e
  // refeito quando destino, peso, volumes ou valor da nota mudam; se o operador
  // informar o valor à mão (`freightManual`), ele deixa de ser refeito. Nulo =
  // a cotar (sem tabela em vigor, ou cidade fora dela). Ver src/lib/frete-coleta.ts.
  freightValue         Float?
  freightDeadlineHours Int?
  freightManual        Boolean  @default(false)
  // Tabela que deu o valor, e a composição e os avisos da conta naquele momento.
  freightTableId       String?
  freightDetails       Json?
  freightTable         FreightTable? @relation(fields: [freightTableId], references: [id], onDelete: SetNull)

  // Fatura em que o frete desta carga foi cobrado. Uma carga entra em no
  // máximo uma fatura; cancelar a fatura solta a carga.
  invoiceId            String?
  invoice              Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  receiverName String?

  // Pedido de coleta: quando buscar, com que urgência e o que o motorista
  // precisa saber. Tudo opcional. `pickupDate` é um dia do calendário (meia-noite
  // UTC); a janela são horas do relógio ("08:00"). `cubicMeters` entra no frete
  // quando a tabela tem fator de cubagem. Ver src/lib/coletas.ts.
  pickupDate   DateTime?
  pickupFrom   String?
  pickupTo     String?
  priority     String   @default("NORMAL") // NORMAL, URGENT
  cubicMeters  Float?
  pickupNotes  String?

  // Endereço da entrega, além da cidade (`destination`). Tudo opcional: vem do
  // pedido (painel e portal) ou da NF-e. `deliveryZip` guarda só os 8 dígitos.
  // Ver src/lib/endereco.ts.
  deliveryStreet   String?
  deliveryNumber   String?
  deliveryDistrict String?
  deliveryZip      String?
  // Coordenada do endereço, achada em segundo plano pelo despachante
  // (src/lib/geo-db.ts). `geoSource`: ADDRESS = achou o endereço; NONE = procurou
  // e não achou (a rota usa o centro da cidade). Nulo = ainda não procurada.
  // Mudar o endereço ou a cidade zera os quatro campos.
  deliveryLat      Float?
  deliveryLon      Float?
  geoSource        String?
  geoAt            DateTime?

  // Codigo publico de rastreio: 10 digitos sorteados com CSPRNG (src/lib/tracking.ts).
  // E o segundo fator do rastreio publico, junto do CNPJ do cliente. Opcional no
  // schema porque as coletas criadas antes desta mudanca recebem o codigo por
  // backfill; toda coleta nova ja nasce com ele.
  trackingCode String?  @unique
  
  // CT-e da carga: o registrado à mão (emitido em outro sistema) ou o que este
  // sistema emitiu e a SEFAZ autorizou EM PRODUÇÃO (tabela "Cte"). CT-e de
  // homologação não tem valor fiscal e não chega a estes campos.
  cteKey      String?  @unique
  cteNumber   Int?
  cteStatus   String?  @default("PENDING") // PENDING, ISSUED, CANCELLED

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  client      Client   @relation(fields: [clientId], references: [id])
  driver      Driver?  @relation(fields: [driverId], references: [id])
  manifest    Manifest? @relation(fields: [manifestId], references: [id])
  statusHistory CollectionStatusHistory[]
  proof       ProofOfDelivery?
  deliveryAttempts DeliveryAttempt[]
  quoteLead   QuoteLead?
  occurrences Occurrence[]
  volumeItems CollectionVolume[]
  warehouseReceipt WarehouseReceipt?
  fiscalDocuments FiscalDocument[]
  ctes        Cte[]

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, clientId])
  @@index([tenantId, createdAt])
  @@index([manifestId])
  @@index([driverId])
  @@index([invoiceId])
}

// Uma linha por status que a coleta assumiu, com quando e quem. `fromStatus`
// e nulo na criacao. Quem grava e `recordStatusChanges` (src/lib/historico.ts)
// ou a criacao aninhada da propria coleta; coleta anterior a esta tabela fica
// sem historico, porque nao ha de onde tirar a data real de cada troca.
model CollectionStatusHistory {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id           String   @id @default(uuid())
  collectionId String
  fromStatus   String?
  toStatus     String
  userId       String?  // nulo quando a troca nao tem pessoa, ou o usuario foi apagado
  createdAt    DateTime @default(now())

  // Relations
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([collectionId, createdAt])

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}

model Manifest {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String   @id @default(uuid())
  driverId    String
  vehicleId   String
  status      String   @default("ASSEMBLING") // ASSEMBLING, ROUTE, FINISHED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Dados da viagem, todos opcionais (src/lib/viagem.ts). O hodômetro de saída
  // e o de retorno dão os km rodados; as previsões são só informação.
  helperId           String?
  departureOdometer  Int?
  returnOdometer     Int?
  plannedDepartureAt DateTime?
  plannedReturnAt    DateTime?
  notes              String?
  // Quando a saída foi liberada e quando a viagem foi finalizada. Nulos nas
  // viagens anteriores a estas colunas: para elas vale `createdAt` como saída
  // e `updatedAt` como finalização (`finalizadaNoPeriodo`).
  departedAt         DateTime?
  finishedAt         DateTime?

  // Última posição que o motorista compartilhou pelo app, com a viagem em rota
  // (src/lib/posicao.ts). `lastAccuracy` é a precisão em metros que o aparelho
  // informou. Só o painel lê: o rastreio público e o portal não mostram.
  lastLat            Float?
  lastLon            Float?
  lastAccuracy       Float?
  lastPositionAt     DateTime?

  // Relations
  driver      Driver    @relation(fields: [driverId], references: [id])
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id])
  helper      Helper?   @relation(fields: [helperId], references: [id], onDelete: SetNull)
  collections Collection[]
  mdfes       Mdfe[]
  advances    CrewAdvance[]
  expenses    TripExpense[]
  positions   TripPosition[]
  deliveryAttempts DeliveryAttempt[]

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([tenantId, status])
}

// Histórico enxuto das posições do motorista numa viagem: no máximo
// `MAXIMO_DE_PONTOS` por viagem (src/lib/posicao.ts), os mais antigos saem.
// Não vai para a auditoria nem para fora do painel.
model TripPosition {
  tenantId   String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id         String   @id @default(uuid())
  manifestId String
  lat        Float
  lon        Float
  accuracy   Float?
  recordedAt DateTime @default(now())

  manifest   Manifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([manifestId, recordedAt])
}

model FinancialTransaction {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String   @id @default(uuid())
  type        String   // INCOME, EXPENSE
  amount      Float
  description String
  dueDate     DateTime?
  status      String   @default("PENDING") // PENDING, PAID
  clientId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Quando e como foi pago (ou recebido). `paidAt` é o que o fluxo de caixa
  // realizado usa; nulo enquanto o lançamento está em aberto.
  paidAt        DateTime?
  paymentMethod String?  // PIX, BOLETO, DINHEIRO, TRANSFERENCIA, CARTAO, OUTRO
  category      String?  // livre: combustível, manutenção, pedágio, folha…
  counterparty  String?  // fornecedor ou pagador que não é cliente cadastrado
  notes         String?
  costCenter    String?  // livre: filial, rota, veículo… Agrupa as despesas no relatório.

  // Baixa de título a receber com encargos. `amount` continua sendo o valor
  // original; `paidAmount` é o que entrou de fato (original + juros + multa −
  // desconto). Os quatro ficam nulos em aberto e na baixa pelo valor cheio.
  interest      Float?
  fine          Float?
  discount      Float?
  paidAmount    Float?

  // Lançamento gerado por uma fatura: nasce, é pago e some junto com ela.
  invoiceId   String?  @unique
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Relations
  client      Client?  @relation(fields: [clientId], references: [id])
  tripExpense TripExpense?
  // A linha do extrato bancário com que este lançamento foi conciliado.
  statementLine BankStatementLine?

  @@index([clientId])

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}

model Maintenance {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String   @id @default(uuid())
  vehicleId   String
  description String
  cost        Float
  date        DateTime
  status      String   @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED
  // PREVENTIVE ou CORRECTIVE. Nulo nas manutenções anteriores a esta coluna.
  kind        String?
  odometer    Int?     // km no hodômetro quando o serviço foi feito
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Frota
//
// O que se registra de cada veículo além da manutenção: abastecimentos,
// documentos com vencimento, pneus e checklists. Consumo, custo por km e a
// situação de cada documento não são gravados: saem das contas de
// src/lib/frota.ts. A CNH do motorista (Driver.cnhExpiry) entra nos mesmos
// alertas de vencimento, lida de onde já está.
// ---------------------------------------------------------------------------

model Fueling {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id        String   @id @default(uuid())
  vehicleId String
  driverId  String?
  date      DateTime // dia do calendário, gravado à meia-noite UTC
  liters    Float
  totalCost Float
  odometer  Int      // km no hodômetro na hora de abastecer
  station   String?  // posto
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  driver    Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)
  // A despesa de viagem que gerou este abastecimento, quando ele nasceu de uma.
  tripExpense TripExpense?

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([vehicleId, date])
}

model VehicleDocument {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id        String   @id @default(uuid())
  vehicleId String
  type      String   // LICENSING, INSURANCE, ANTT, TACHOGRAPH, OTHER
  number    String?
  expiresAt DateTime // dia do calendário, gravado à meia-noite UTC
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([vehicleId])
  @@index([tenantId, expiresAt])
}

// Registro simples de pneu, sem estoque: onde está, desde quando e, quando
// sai, com quantos km saiu.
model Tire {
  tenantId    String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String   @id @default(uuid())
  vehicleId   String
  position    String   // livre: "Dianteiro esquerdo", "Eixo 2 direito interno"…
  brandModel  String
  installedAt DateTime // dia do calendário, gravado à meia-noite UTC
  installedKm Int
  removedKm   Int?     // nulo enquanto o pneu está no veículo
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([vehicleId])
}

model VehicleChecklist {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id        String   @id @default(uuid())
  vehicleId String
  // Quem fez: usuário do painel ou do motorista. Nulo se o usuário foi apagado.
  userId    String?
  date      DateTime @default(now()) // instante em que foi registrado
  odometer  Int?
  // Um booleano por item fixo (CHECKLIST_ITENS em src/lib/frota.ts): true = OK, false = problema.
  items     Json
  notes     String?
  createdAt DateTime @default(now())

  // Relations
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([vehicleId, date])
}

// ---------------------------------------------------------------------------
// Equipe (recursos humanos operacional)
//
// Quem vai para a estrada: o motorista (Driver, que já existia) e o ajudante
// (Helper, sem login). Ausência e adiantamento são de um ou de outro: uma das
// duas colunas (`driverId`, `helperId`) vem preenchida, nunca as duas. Quem
// está ausente num dia, a diferença do acerto e a comissão não são gravados:
// saem das contas de src/lib/equipe.ts.
// ---------------------------------------------------------------------------
model Helper {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id        String   @id @default(uuid())
  name      String
  cpf       String   // só dígitos
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  absences  Absence[]
  advances  CrewAdvance[]
  manifests Manifest[]

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, cpf])
}

model Absence {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id        String   @id @default(uuid())
  driverId  String?
  helperId  String?
  type      String   // VACATION, DAY_OFF, SICK_NOTE, MISSED, OTHER
  // Primeiro e último dia, os dois inclusive: dias do calendário, gravados à meia-noite UTC.
  startDate DateTime
  endDate   DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  driver    Driver?  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  helper    Helper?  @relation(fields: [helperId], references: [id], onDelete: Cascade)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([tenantId, startDate, endDate])
  @@index([driverId])
  @@index([helperId])
}

// Dinheiro entregue a quem vai viajar, e o acerto na volta. Registrar lança a
// despesa no Financeiro (categoria "Adiantamento"), como a manutenção faz.
model CrewAdvance {
  tenantId    String    @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String    @id @default(uuid())
  driverId    String?
  helperId    String?
  date        DateTime  // dia do calendário, gravado à meia-noite UTC
  amount      Float
  reason      String    // TRIP, VOUCHER, OTHER
  manifestId  String?   // a viagem do adiantamento, quando é de uma
  status      String    @default("OPEN") // OPEN, SETTLED
  // No acerto: quanto do adiantamento foi gasto com comprovante, e quando se acertou.
  spentAmount Float?
  settledAt   DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  driver      Driver?   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  helper      Helper?   @relation(fields: [helperId], references: [id], onDelete: Cascade)
  manifest    Manifest? @relation(fields: [manifestId], references: [id], onDelete: SetNull)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([driverId])
  @@index([helperId])
  @@index([manifestId])
}

// Comprovante da entrega de uma carga, registrado pelo motorista na baixa.
// A entrega e a propria carga (Collection): nao ha registro de entrega a parte.
// Despesa de uma viagem (pedágio, combustível, alimentação...), lançada pelo
// painel ou pelo motorista no aplicativo. Nasce pendente; o administrador
// aprova (e ela vira lançamento no Financeiro) ou recusa. Ver src/lib/viagem.ts.
model TripExpense {
  tenantId   String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id         String   @id @default(uuid())
  manifestId String
  type       String   // TOLL, FUEL, FOOD, LODGING, PARKING, MAINTENANCE, OTHER
  amount     Float
  date       DateTime // dia do calendário, gravado à meia-noite UTC
  notes      String?
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED
  // Quem lançou: é por aqui que o motorista só vê as dele.
  createdById String?
  // Quem aprovou ou recusou, e quando.
  reviewedById String?
  reviewedAt   DateTime?
  // Só no combustível: com litros e hodômetro a despesa gera o abastecimento
  // da frota (`fuelingId`), e o consumo do veículo sai dele.
  liters     Float?
  odometer   Int?
  fuelingId  String?  @unique
  // O lançamento que a aprovação criou no Financeiro.
  transactionId String? @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  manifest    Manifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation("TripExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy  User?    @relation("TripExpenseReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  fueling     Fueling? @relation(fields: [fuelingId], references: [id], onDelete: SetNull)
  transaction FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([manifestId])
  @@index([tenantId, status])
}

model ProofOfDelivery {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id              String   @id @default(uuid())
  collectionId    String   @unique
  photoBase64     String?  @db.Text
  signatureBase64 String?  @db.Text
  receiverName    String
  receiverDoc     String
  latitude        Float?
  longitude       Float?
  // Quem recebeu em relação ao destinatário: DESTINATARIO, FUNCIONARIO,
  // PORTARIA, FAMILIAR, VIZINHO, OUTRO. Nulo nos comprovantes antigos.
  receiverRelation String?
  // Ressalva no ato da entrega: AVARIA, FALTA, VIOLADA, OUTRA, com a descrição
  // de quem entregou. Os dois nulos = entrega sem ressalva.
  exceptionType   String?
  exceptionNote   String?
  // Distância, em metros, entre a posição da baixa e a coordenada do endereço
  // de entrega. Nulo = sem posição ou sem coordenada. Só o painel lê.
  distanceMeters  Int?
  // SUBMITTED, APPROVED, REJECTED. REJECTED = devolvido ao motorista, que manda
  // fotos novas e o comprovante volta para SUBMITTED. APPROVED é final.
  status          String   @default("SUBMITTED")
  // Conferência no painel: quem decidiu, quando e, na devolução, o motivo.
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  collection      Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  reviewedBy      User?      @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  photos          ProofPhoto[]
  rejections      ProofRejection[]

  @@index([status, createdAt])

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}

// Foto de um comprovante de entrega (ENTREGA = carga no local, CANHOTO =
// canhoto assinado, AVARIA, FACHADA) ou de uma tentativa sem sucesso (FACHADA).
// Pertence a um dos dois: `proofId` ou `attemptId`. A imagem fica embutida
// (data URL JPEG, PNG ou WebP) e o `sha256` é o dos bytes dela, calculado no
// servidor. Foto substituída no reenvio não é apagada: fica com `replacedAt`.
model ProofPhoto {
  tenantId   String    @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id         String    @id @default(uuid())
  proofId    String?
  attemptId  String?
  kind       String    // ENTREGA, CANHOTO, AVARIA, FACHADA
  dataUrl    String    @db.Text
  sha256     String
  createdAt  DateTime  @default(now())
  replacedAt DateTime?

  proof      ProofOfDelivery? @relation(fields: [proofId], references: [id], onDelete: Cascade)
  attempt    DeliveryAttempt? @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([proofId])
  @@index([attemptId])
}

// Cada devolução de um comprovante ao motorista: quem devolveu, quando e por
// quê. `resubmittedAt` marca quando o motorista respondeu com fotos novas;
// nulo = ainda esperando por ele.
model ProofRejection {
  tenantId      String    @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id            String    @id @default(uuid())
  proofId       String
  reason        String
  rejectedById  String?
  rejectedAt    DateTime  @default(now())
  resubmittedAt DateTime?

  proof         ProofOfDelivery @relation(fields: [proofId], references: [id], onDelete: Cascade)
  rejectedBy    User?           @relation(fields: [rejectedById], references: [id], onDelete: SetNull)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([proofId, rejectedAt])
}

// Tentativa de entrega sem sucesso, registrada pelo motorista. Uma carga pode
// ter várias. Nasce junto de um chamado (`occurrenceId`), que é por onde a
// equipe trata. `clientKey` é a chave que o aparelho manda para o reenvio da
// mesma tentativa não virar duas. A posição só o painel lê.
model DeliveryAttempt {
  tenantId       String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id             String   @id @default(uuid())
  collectionId   String
  manifestId     String?
  occurrenceId   String?  @unique
  // AUSENTE, ENDERECO_NAO_LOCALIZADO, RECUSADO, FECHADO, MUDOU_SE, AREA_DE_RISCO, OUTRO
  reason         String
  note           String?
  latitude       Float?
  longitude      Float?
  distanceMeters Int?
  clientKey      String?
  createdAt      DateTime @default(now())

  collection     Collection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  manifest       Manifest?   @relation(fields: [manifestId], references: [id], onDelete: SetNull)
  occurrence     Occurrence? @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)
  photos         ProofPhoto[]

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, clientKey])
  @@index([collectionId, createdAt])
}

model QuoteLead {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id              String   @id @default(uuid())
  companyName     String
  email           String
  phone           String
  origin          String
  destination     String
  volumes         Int
  weight          Float
  estimatedValue  Float?
  // Valor da nota informado no pedido de cotação; segue para a coleta na conversão.
  invoiceValue    Float?
  status          String   @default("NEW") // NEW, CONTACTED, CONVERTED, LOST
  // Coleta criada na conversão do lead (src/lib/crm.ts). Uma coleta por lead.
  collectionId    String?  @unique
  collection      Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Atendimento e ocorrências
//
// Chamado de um cliente (aberto no portal) ou da equipe (painel, ou o motorista
// numa entrega) sobre uma carga ou sobre o serviço. O número é sequencial por
// empresa, como o da fatura. A conversa fica em OccurrenceMessage; a nota
// interna (`internal`) nunca vai para o portal. Regras em src/lib/ocorrencias.ts.
// ---------------------------------------------------------------------------
model Occurrence {
  tenantId     String    @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id           String    @id @default(uuid())
  number       Int       // sequencial por empresa
  type         String    // DELAY, DAMAGE, LOSS, BILLING, REDELIVERY, OTHER
  title        String
  description  String    @db.Text
  status       String    @default("OPEN") // OPEN, ANALYSIS, IN_PROGRESS, RESOLVED, CLOSED
  priority     String    @default("NORMAL") // LOW, NORMAL, HIGH
  // A carga de que o chamado trata, quando trata de uma.
  collectionId String?
  // O cliente a quem o chamado pertence: é por aqui que o portal filtra. Nulo = chamado só da equipe.
  clientId     String?
  // Quem abriu, e de que lado: CLIENT (portal) ou STAFF (painel ou motorista).
  openedById   String?
  origin       String    @default("STAFF")
  // Quem da equipe cuida do chamado.
  assigneeId   String?
  openedAt     DateTime  @default(now())
  resolvedAt   DateTime?
  closedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  client       Client?     @relation(fields: [clientId], references: [id])
  openedBy     User?       @relation("OccurrenceOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  assignee     User?       @relation("OccurrenceAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages     OccurrenceMessage[]
  deliveryAttempt DeliveryAttempt?

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([clientId])
  @@index([collectionId])
}

// Andamento do chamado, em ordem cronológica.
model OccurrenceMessage {
  tenantId     String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id           String   @id @default(uuid())
  occurrenceId String
  authorId     String?  // nulo se o usuário foi apagado
  // De que lado veio, gravado na hora: o perfil do autor pode mudar depois.
  fromClient   Boolean  @default(false)
  // Nota interna: só a equipe lê. O portal nunca recebe estas linhas.
  internal     Boolean  @default(false)
  body         String   @db.Text
  createdAt    DateTime @default(now())

  // Relations
  occurrence   Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  author       User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([occurrenceId, createdAt])
}

// ---------------------------------------------------------------------------
// Recebimento, conferência e depósito
//
// A carga (Collection) diz quantos volumes tem. Cada volume ganha uma linha em
// CollectionVolume quando é conferido no depósito: recebido, avariado ou
// faltando. O código do volume é o código de rastreio da carga mais a
// sequência ("1234567890-02"); enquanto o volume não foi conferido ele não tem
// linha, e o código sai da conta (src/lib/deposito.ts), que é o que a etiqueta
// imprime. WarehouseReceipt é a conferência concluída da carga: quem, quando e
// as divergências encontradas. WarehouseLocation é a posição no depósito.
// ---------------------------------------------------------------------------
model WarehouseLocation {
  tenantId    String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String   @id @default(uuid())
  // Código curto, em maiúsculas, como está escrito na prateleira: "A-01-03".
  code        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  volumes     CollectionVolume[]

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, code])
}

model CollectionVolume {
  tenantId     String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id           String   @id @default(uuid())
  collectionId String
  sequence     Int      // 1 até Collection.volumes
  code         String   // código de rastreio + "-" + sequência
  status       String   @default("RECEIVED") // RECEIVED, DAMAGED, MISSING
  weight       Float?   // peso conferido, em kg
  damageNote   String?  // o que há de errado, quando avariado
  locationId   String?  // posição no depósito
  checkedAt    DateTime @default(now())
  checkedById  String?  // nulo se o usuário foi apagado
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  collection   Collection         @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  location     WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  checkedBy    User?              @relation(fields: [checkedById], references: [id], onDelete: SetNull)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, code])
  @@unique([collectionId, sequence])
  @@index([locationId])
}

// A conferência concluída de uma carga. Os números são os do momento em que
// foi concluída, e são refeitos se um volume mudar depois (um faltante que
// apareceu). Peso conferido é nulo quando nem todo volume presente foi pesado.
model WarehouseReceipt {
  tenantId        String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id              String   @id @default(uuid())
  collectionId    String   @unique
  userId          String?  // quem concluiu; nulo se o usuário foi apagado
  concludedAt     DateTime @default(now())
  expectedVolumes Int      // o declarado na carga
  receivedVolumes Int      // presentes sem avaria
  damagedVolumes  Int      // presentes com avaria
  missingVolumes  Int
  declaredWeight  Float
  checkedWeight   Float?
  quantityDivergence Boolean @default(false)
  weightDivergence   Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  collection      Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user            User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}

// Nota fiscal eletrônica (NF-e, modelo 55) importada pelo XML. Guarda o que o
// leitor extraiu (src/lib/nfe.ts) e o XML original, como chegou. A chave de
// acesso é única por empresa: a mesma nota não entra duas vezes. A carga é
// opcional: a nota pode ser importada antes de existir carga para ela.
model FiscalDocument {
  tenantId        String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id              String   @id @default(uuid())
  accessKey       String   // 44 dígitos, com o dígito verificador conferido
  number          Int
  series          Int
  issuedAt        DateTime?
  operationNature String?
  // 0 = frete por conta do emitente, 1 = do destinatário (campo modFrete da nota).
  freightMode     Int?

  issuerTaxId     String   // CNPJ ou CPF, só dígitos
  issuerName      String
  issuerCity      String?
  issuerState     String?
  issuerAddress   String?

  recipientTaxId  String?
  recipientName   String?
  recipientCity   String?
  recipientState  String?
  recipientAddress String?

  totalValue      Float    // vNF
  grossWeight     Float?   // soma de transp/vol/pesoB
  volumes         Int?     // soma de transp/vol/qVol

  xml             String   @db.Text

  collectionId    String?
  importedById    String?  // quem importou; nulo se o usuário foi apagado
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  collection      Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  importedBy      User?       @relation(fields: [importedById], references: [id], onDelete: SetNull)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, accessKey])
  @@index([tenantId, createdAt])
  @@index([collectionId])
}

// ---------------------------------------------------------------------------
// Conteúdo e distribuição
//
// A matéria do blog continua sendo escrita em src/content/blog.ts, que é quem
// gera a página, o sitemap e os dados estruturados. O banco não duplica o texto:
// ele registra que a matéria existe (Article) e guarda o que interessa depois de
// publicada, que é para onde ela foi (SocialPost) e quanto rendeu (ContentMetric).
//
// O mesmo SocialPost serve blog, Instagram, Google Meu Negócio e o resto: o que
// muda entre eles é o canal e o formato do texto, não o ciclo de vida. Por isso
// há uma tabela só, com canal como campo, em vez de uma tabela por rede.
// ---------------------------------------------------------------------------

enum Channel {
  BLOG
  INSTAGRAM
  GOOGLE_BUSINESS
  FACEBOOK
  LINKEDIN
  WHATSAPP_STATUS
}

enum PostStatus {
  DRAFT     // escrito, ninguém aprovou
  APPROVED  // liberado pelo comercial, esperando a hora
  SCHEDULED // tem data marcada
  PUBLISHED // saiu
  FAILED    // tentou sair e a API recusou
  CANCELED  // desistiu-se antes de publicar
}

model Article {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String   @id @default(uuid())
  slug        String   @unique // o mesmo slug de src/content/blog.ts
  title       String
  description String
  category    String
  publishedAt DateTime
  // Espelho do que está no arquivo, para o painel mostrar sem ler o bundle.
  // A página do site nunca lê daqui: quem manda é o blog.ts.
  syncedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  posts       SocialPost[]
  metrics     ContentMetric[]

  @@index([publishedAt])

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}

model SocialPost {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String     @id @default(uuid())
  channel     Channel
  status      PostStatus @default(DRAFT)

  // O texto que vai para a rede. Cada canal tem o seu, porque a legenda do
  // Instagram não é o resumo do Google Meu Negócio.
  body        String     @db.Text
  imageUrl    String?
  linkUrl     String?    // para onde o post aponta: a matéria, a cotação, o site

  articleId   String?    // post que divulga uma matéria; nulo quando é post avulso
  scheduledFor DateTime? // quando deve sair
  publishedAt DateTime?  // quando saiu de fato

  // Devolvido pela API da rede no momento em que o post sai. Guardado para
  // conseguir achar o post de volta e para não republicar o mesmo duas vezes.
  externalId  String?
  externalUrl String?

  // Preenchido só quando status = FAILED. Erro sem texto vira falha invisível,
  // e falha invisível é a que ninguém conserta.
  failureReason String?  @db.Text
  attempts    Int        @default(0)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  article     Article?   @relation(fields: [articleId], references: [id])

  // O mesmo post não sai duas vezes no mesmo canal, nem quando o fluxo do n8n
  // repete a chamada.
  @@unique([channel, externalId])
  @@index([status, scheduledFor])
  @@index([articleId])

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}

model ContentMetric {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String   @id @default(uuid())
  articleId   String
  measuredOn  DateTime @db.Date // a data da medição, não o instante

  // Search Console, últimos 28 dias na data da medição.
  impressions Int      @default(0)
  clicks      Int      @default(0)
  position    Float?
  ctr         Float?

  createdAt   DateTime @default(now())

  // Relations
  article     Article  @relation(fields: [articleId], references: [id])

  // Uma medição por matéria por dia: rodar o fluxo duas vezes na mesma terça
  // não pode dobrar o número.
  @@unique([articleId, measuredOn])
  @@index([measuredOn])

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Eventos para sistemas de fora (n8n e afins)
//
// A empresa cadastra um endereço (Webhook). A partir daí, cada troca de status
// de carga vira uma linha em OutboxEvent, gravada por gatilho na mesma
// transação da troca (prisma/sql/010-rls.sql): evento não se perde nem sai sem
// a troca ter acontecido. Quem entrega é src/lib/eventos.ts, com assinatura e
// novas tentativas. Empresa sem Webhook não gera evento.
// ---------------------------------------------------------------------------

model Webhook {
  tenantId  String   @unique @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id        String   @id @default(uuid())
  url       String
  // Segredo da assinatura (HMAC-SHA256 do corpo). Mostrado uma vez, ao ser criado.
  secret    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
}

model OutboxEvent {
  tenantId      String    @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id            String    @id @default(uuid())
  type          String    // coleta.status, fatura.emitida|paga|reaberta|cancelada, cobranca.vencida, ocorrencia.aberta|status, teste
  payload       Json
  createdAt     DateTime  @default(now())
  // Próxima tentativa de entrega. Cada tentativa empurra para a frente (1, 2, 4... minutos).
  nextAttemptAt DateTime  @default(now())
  attempts      Int       @default(0)
  deliveredAt   DateTime?
  lastError     String?
  // Evento que só pode existir uma vez (o aviso de um título vencido): a chave repetida é ignorada.
  dedupeKey     String?   @unique

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId, createdAt])
  @@index([deliveredAt, nextAttemptAt])
}

// ---------------------------------------------------------------------------
// Auditoria
//
// Uma linha por ação importante (quem, quando, de onde, o que mudou). Só
// inserção: o papel da aplicação não tem UPDATE nem DELETE nesta tabela
// (prisma/sql/010-rls.sql). O nome e o perfil de quem fez ficam copiados na
// linha, porque o usuário pode ser apagado depois. Ver src/lib/auditoria.ts.
// ---------------------------------------------------------------------------
model AuditLog {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String?  // nulo se o usuário foi apagado depois
  userName  String
  userRole  String?
  action    String   // texto curto e estável: cliente.criar, fatura.pagar, usuario.perfil...
  entity    String   // cliente, fatura, usuario...
  entityId  String?
  summary   String   // frase em português, para a lista
  before    Json?    // só os campos que mudaram, sem segredo nem imagem
  after     Json?
  ip        String?
  device    String?  // resumo do navegador e do aparelho

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Notificações para as pessoas (sininho e push no navegador)
//
// `Notification` é o aviso de uma pessoa: só ela lê e marca como lido (as rotas
// de /api/notificacoes filtram sempre pelo usuário da sessão). Nasce na mesma
// transação da ação que o causou (src/lib/notificacoes.ts) e o despachante o
// manda por push para os aparelhos da pessoa (src/lib/notificacoes-push.ts).
// ---------------------------------------------------------------------------
model Notification {
  tenantId  String    @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id        String    @id @default(uuid())
  userId    String    // o destinatário
  type      String    // texto curto e estável: viagem.liberada, coleta.entregue, chamado.novo...
  title     String
  body      String
  url       String    // caminho interno que o aviso abre, ex. /dashboard/ocorrencias/<id>
  createdAt DateTime  @default(now())
  readAt    DateTime?
  // Quando o despachante pegou o aviso para mandar por push. Nulo = ainda não
  // pegou. Uma tentativa por aviso: marcado antes do envio, não volta para a fila.
  pushedAt  DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([pushedAt])
}

// O aparelho (navegador) em que a pessoa ativou o push. O endereço é dado pelo
// serviço de push do navegador e é único no mundo: um aparelho só recebe os
// avisos de uma pessoa por vez (a rota apaga a inscrição anterior ao gravar).
model PushSubscription {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique @db.Text
  p256dh    String
  auth      String
  userAgent String?  // resumo do navegador e do aparelho, como na auditoria
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Conciliação bancária por extrato importado (OFX)
//
// Uma linha por movimentação do extrato que o administrador exportou do banco
// e enviou (src/lib/ofx.ts lê o arquivo). A linha é única por conta + `fitId`
// (o identificador da movimentação no banco): reenviar o mesmo extrato, ou um
// período que se sobrepõe, não duplica. As regras estão em src/lib/conciliacao.ts.
//
// Do número da conta ficam só o fim (`account`, "••••1234") e um resumo
// criptográfico do banco + agência + número (`accountKey`), que é o que separa
// uma conta da outra na unicidade.
// ---------------------------------------------------------------------------
model BankStatementLine {
  tenantId    String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String   @id @default(uuid())
  accountKey  String
  bankId      String?  // código do banco, como veio no arquivo
  account     String   // conta mascarada: só o fim do número
  fitId       String
  postedAt    DateTime // dia do calendário, gravado à meia-noite UTC
  amount      Float    // com sinal: positivo entrou, negativo saiu
  kind        String?  // TRNTYPE do OFX: CREDIT, DEBIT, XFER, FEE...
  description String
  status      String   @default("PENDING") // PENDING, RECONCILED, IGNORED
  // O lançamento com que a linha foi conciliada. Um lançamento casa com uma linha só.
  transactionId String? @unique
  // A baixa do lançamento veio desta conciliação (ele estava em aberto):
  // desfazer a conciliação reabre o título. Falso quando ele já estava pago
  // ou nasceu pago a partir da linha.
  settled     Boolean  @default(false)
  reconciledAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transaction FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@unique([tenantId, accountKey, fitId])
  @@index([tenantId])
  @@index([tenantId, status, postedAt])
}

// ---------------------------------------------------------------------------
// Cobrança pelo Mercado Pago (Pix dinâmico e boleto com baixa automática)
//
// Cada empresa liga a PRÓPRIA conta: o Access Token e o segredo de assinatura
// do webhook ficam cifrados (AES-256-GCM, src/lib/cifra.ts) e nunca voltam para
// a tela; os 4 últimos caracteres ficam ao lado só para a pessoa reconhecer
// qual credencial está cadastrada. Ver src/lib/cobranca-gateway-db.ts.
// ---------------------------------------------------------------------------
model PaymentGateway {
  tenantId  String   @unique @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id        String   @id @default(uuid())
  provider  String   @default("MERCADO_PAGO")
  accessTokenEnc    String @db.Text
  accessTokenEnd    String // 4 últimos caracteres
  webhookSecretEnc  String @db.Text
  webhookSecretEnd  String // 4 últimos caracteres
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
}

// Uma cobrança criada no gateway para uma fatura. A fatura pode ter várias
// (gerou de novo depois de vencer), mas só uma em aberto por tipo: quem garante
// é a criação, que trava a fatura antes de conferir.
model PaymentCharge {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id        String   @id @default(uuid())
  invoiceId String
  provider  String   @default("MERCADO_PAGO")
  kind      String   // PIX, BOLETO
  // CREATING (pedido enviado, sem resposta ainda), PENDING (em aberto), PAID,
  // CANCELLED, EXPIRED, FAILED (o gateway recusou criar), REVIEW (a conferir:
  // o gateway disse algo que o sistema não aplica sozinho).
  status    String   @default("CREATING")
  // Id do pagamento no gateway. Nulo enquanto a criação não foi confirmada.
  gatewayId String?
  // Chave de idempotência da tentativa: repetir o pedido com ela não cria outro pagamento.
  idempotencyKey String
  amount    Float
  // Quanto o gateway diz que foi pago (pode diferir do valor: juros ou desconto).
  paidAmount Float?
  pixCode    String? @db.Text // Pix Copia e Cola
  qrCodeBase64 String? @db.Text // imagem do QR Code, como o gateway devolve
  ticketUrl  String? @db.Text // página do Pix ou do boleto no gateway
  digitableLine String? // linha digitável do boleto, se o gateway devolver
  expiresAt DateTime // vencimento da cobrança no gateway
  paidAt    DateTime?
  // Por que está "a conferir" ou não foi criada: texto para a tela, sem dado sensível.
  note      String?
  checkedAt DateTime? // última consulta ao gateway
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@unique([tenantId, gatewayId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([invoiceId])
  @@index([status, createdAt])
}

// Cache da localização de endereços (src/lib/geo-db.ts). NÃO tem `tenantId` de
// propósito: a coordenada de um endereço é dado público, igual para todas as
// empresas, e o cache é do sistema (evita repetir a consulta ao Nominatim, que
// aceita no máximo uma por segundo). Sem `tenantId` a tabela fica sem política
// e sem permissão para o papel da aplicação: só o cliente `sistema` lê e grava.
// Guarda apenas o texto normalizado do endereço e a coordenada: nada que diga
// de que empresa, cliente ou carga veio a pergunta.
model GeoCache {
  // O endereço normalizado: "rua das flores 120|mirassol|sp" (src/lib/endereco.ts).
  key       String   @id
  // Nulos quando o serviço respondeu que não achou: também é resposta, e não se pergunta de novo.
  lat       Float?
  lon       Float?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Emissão de CT-e (modelo 57, modal rodoviário, leiaute 4.00)
// ---------------------------------------------------------------------------

// Dados fiscais do emitente e o certificado digital A1 da empresa (Empresa →
// Fiscal). Uma linha por empresa. Ver src/lib/cte.ts e src/lib/cte-db.ts.
//
// O certificado (.pfx) e a senha dele ficam CIFRADOS (AES-256-GCM, chave
// derivada de TMS_CHAVE_DE_DADOS; src/lib/cifra.ts) e nunca saem do servidor:
// em claro ficam só o titular, o CNPJ e a validade, que a tela mostra. Os cinco
// campos `cert*` nulos = sem certificado.
model FiscalIssuer {
  tenantId     String   @unique @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id           String   @id @default(uuid())
  cnpj         String   // só dígitos
  ie           String   // só dígitos
  legalName    String
  tradeName    String?
  street       String
  number       String
  complement   String?
  district     String
  cityCode     String   // código IBGE do município, 7 dígitos
  cityName     String
  state        String
  zip          String   // só dígitos
  phone        String?
  rntrc        String
  taxRegime    String   // CRT: 1, 2, 3 ou 4
  cteSeries    Int      @default(1)
  // MDF-e (src/lib/mdfe.ts): a série, o tipo de emitente (1 = prestador de
  // serviço de transporte, relaciona CT-e; 2 = carga própria, relaciona NF-e) e
  // o seguro da carga que a empresa usa por padrão (a averbação é de cada viagem).
  mdfeSeries       Int     @default(1)
  mdfeEmitterType  String  @default("1")
  insurerName      String?
  insurerTaxId     String?
  insurancePolicy  String?
  environment  String   @default("HOMOLOGACAO") // HOMOLOGACAO, PRODUCAO
  cfopInState  String
  cfopOutState String
  icmsCst      String   // 00, 40, 41, 90 ou SN (Simples Nacional)
  icmsRate     Float    @default(0)

  // IBS e CBS da Reforma Tributária (grupo imp/IBSCBS do CT-e). CST e
  // classificação nulos = o CT-e vai sem o grupo. As alíquotas, em %, são as do
  // ano (2026: 0,1 / 0 / 0,9). PIS e COFINS só entram na base de cálculo.
  ibsCbsCst    String?
  ibsCbsClass  String?
  ibsStateRate Float    @default(0.1)
  ibsCityRate  Float    @default(0)
  cbsRate      Float    @default(0.9)
  pisRate      Float    @default(0)
  cofinsRate   Float    @default(0)

  certPfxEnc      String?   @db.Text
  certPasswordEnc String?   @db.Text
  certSubject     String?   // nome comum (CN) do certificado
  certTaxId       String?   // CNPJ do certificado
  certNotBefore   DateTime?
  certNotAfter    DateTime?
  certUploadedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
}

// Próximo número de CT-e de cada série, por ambiente: homologação e produção
// têm numerações separadas na SEFAZ. Quem pega o número trava a empresa
// (`pg_advisory_xact_lock`), como a fatura.
model CteNumbering {
  tenantId    String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String   @id @default(uuid())
  environment String   // HOMOLOGACAO, PRODUCAO
  series      Int
  nextNumber  Int      @default(1)
  updatedAt   DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, environment, series])
}

// Cada CT-e que este sistema montou para uma carga. `status`:
//   DRAFT      montado e numerado, sem resposta definitiva da SEFAZ (inclui o
//              envio que ficou sem resposta: `unanswered`);
//   REJECTED   a SEFAZ rejeitou (`statusCode` e `statusReason` dizem por quê);
//   AUTHORIZED a SEFAZ autorizou: há `protocol` e o `xmlReturn` (cteProc);
//   CANCELLED  autorizado e depois cancelado por evento.
// Só existe AUTHORIZED com protocolo devolvido pela SEFAZ.
// Uma carga tem no máximo um CT-e em andamento (DRAFT/REJECTED) e um autorizado
// por ambiente; os cancelados ficam como histórico.
model Cte {
  tenantId     String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id           String   @id @default(uuid())
  collectionId String
  environment  String   // HOMOLOGACAO, PRODUCAO
  series       Int
  number       Int
  accessKey    String   // 44 dígitos
  status       String   @default("DRAFT")

  xmlSent      String   @db.Text  // o CT-e assinado, como foi (ou vai ser) enviado
  xmlReturn    String?  @db.Text  // o cteProc: CT-e + protocolo de autorização
  protocol     String?
  statusCode   Int?     // cStat da última resposta
  statusReason String?  // xMotivo da última resposta, ou o problema do envio
  issuedAt     DateTime // dhEmi
  authorizedAt DateTime?

  cancelledAt    DateTime?
  cancelProtocol String?
  cancelReason   String?
  cancelXml      String?  @db.Text // o evento assinado e o retorno da SEFAZ

  // Envio em andamento (uma emissão por vez por carga) e envio que ficou sem
  // resposta: a próxima tentativa consulta a SEFAZ pela chave antes de reenviar.
  sendingAt    DateTime?
  unanswered   Boolean  @default(false)
  // A SEFAZ disse que o número já foi usado por outro documento (rejeição 539):
  // a próxima tentativa desta carga pega número novo.
  numberBurned Boolean  @default(false)

  issuedById   String?  // quem emitiu; nulo se o usuário foi apagado
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  issuedBy     User?      @relation(fields: [issuedById], references: [id], onDelete: SetNull)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, accessKey])
  @@unique([tenantId, environment, series, number])
  @@index([tenantId, collectionId])
  @@index([collectionId])
}

// A numeração do MDF-e: o próximo número de cada série, por ambiente
// (homologação e produção têm numerações separadas), como a do CT-e.
model MdfeNumbering {
  tenantId    String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String   @id @default(uuid())
  environment String   // HOMOLOGACAO, PRODUCAO
  series      Int
  nextNumber  Int      @default(1)
  updatedAt   DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, environment, series])
}

// Um MDF-e (modelo 58, modal rodoviário) montado para uma viagem. A viagem tem
// um MDF-e por UF de descarregamento (Ajuste SINIEF 21/10, cláusula terceira,
// § 2º). Situações: DRAFT (montado, ainda sem resposta que decida), REJECTED,
// AUTHORIZED, CLOSED (encerrado) e CANCELLED. Só fica AUTHORIZED com o
// protocolo que a SEFAZ devolveu (src/lib/mdfe-db.ts).
model Mdfe {
  tenantId     String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id           String   @id @default(uuid())
  manifestId   String
  environment  String   // HOMOLOGACAO, PRODUCAO
  series       Int
  number       Int
  accessKey    String   // 44 posições
  status       String   @default("DRAFT")
  emitterType  String   // tpEmit: 1 ou 2
  loadState    String   // UFIni
  unloadState  String   // UFFim
  plate        String   // placa do veículo de tração, como foi no documento

  // O que a pessoa informou para este documento (percurso, CIOT, seguro,
  // produto predominante...), para a tela reabrir como estava.
  inputs       Json?

  xmlSent      String   @db.Text  // o MDF-e assinado, como foi (ou vai ser) enviado
  xmlReturn    String?  @db.Text  // o mdfeProc: MDF-e + protocolo de autorização
  protocol     String?
  statusCode   Int?     // cStat da última resposta
  statusReason String?  // xMotivo da última resposta, ou o problema do envio
  issuedAt     DateTime // dhEmi
  authorizedAt DateTime?

  closedAt       DateTime?
  closeProtocol  String?
  cancelledAt    DateTime?
  cancelProtocol String?
  cancelReason   String?

  // Envio em andamento e envio que ficou sem resposta: a próxima tentativa
  // consulta a SEFAZ pela chave antes de reenviar (como no CT-e).
  sendingAt    DateTime?
  unanswered   Boolean  @default(false)
  // Rejeição 539: o número já foi usado por outro documento.
  numberBurned Boolean  @default(false)
  // Quando o aviso de "autorizado há dias e não encerrado" foi dado: um por MDF-e.
  closeReminderAt DateTime?

  issuedById   String?  // quem emitiu; nulo se o usuário foi apagado
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  manifest     Manifest @relation(fields: [manifestId], references: [id], onDelete: Restrict)
  issuedBy     User?    @relation(fields: [issuedById], references: [id], onDelete: SetNull)
  events       MdfeEvent[]

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, accessKey])
  @@unique([tenantId, environment, series, number])
  @@index([tenantId, manifestId])
  @@index([manifestId])
  @@index([status, authorizedAt])
}

// Cada evento que a SEFAZ REGISTROU para um MDF-e (cancelamento 110111,
// encerramento 110112, inclusão de condutor 110114, inclusão de DF-e 110115):
// o XML assinado que foi enviado, o retorno e o protocolo. Evento recusado não
// vira linha: a resposta da SEFAZ volta para a tela e fica na auditoria.
model MdfeEvent {
  tenantId     String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id           String   @id @default(uuid())
  mdfeId       String
  type         String   // tpEvento
  sequence     Int      // nSeqEvento
  xmlSent      String   @db.Text
  xmlReturn    String   @db.Text
  protocol     String?  // nulo quando a SEFAZ só confirmou que o evento já estava lá
  statusCode   Int
  statusReason String
  registeredAt DateTime
  // O que o evento disse, para a tela: justificativa, município do encerramento, condutor incluído...
  details      Json?
  createdById  String?
  createdAt    DateTime @default(now())

  mdfe         Mdfe     @relation(fields: [mdfeId], references: [id], onDelete: Restrict)
  createdBy    User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, mdfeId, type, sequence])
  @@index([mdfeId])
}
