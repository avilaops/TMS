generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OPERATION
  DRIVER
  CLIENT
}

// ---------------------------------------------------------------------------
// Multi-tenant
//
// Cada transportadora que usa o sistema e um Tenant. Toda tabela de negocio
// carrega `tenantId`, e quem separa uma empresa da outra e o proprio Postgres:
// as politicas de seguranca por linha (prisma/sql/010-rls.sql) so mostram as
// linhas do tenant gravado em `app.tenant_id` na transacao. O codigo nao
// preenche `tenantId` na mao: o valor padrao da coluna le essa mesma variavel,
// e sem ela o INSERT falha. Ver src/lib/prisma.ts.
// ---------------------------------------------------------------------------
model Tenant {
  id        String   @id @default(uuid())
  // Identificador curto e estavel (URL, integracoes). So letras minusculas, numeros e hifen.
  slug      String   @unique
  name      String
  cnpj      String?  @unique
  // Símbolo da empresa: data URL de imagem pequena. Nulo = símbolo padrão. Ver src/lib/empresa.ts.
  logo      String?  @db.Text
  active    Boolean  @default(true)
  // Encargos sugeridos na baixa de um título vencido: multa (% do valor, uma
  // vez) e juros (% ao mês, proporcional aos dias de atraso). Ver src/lib/cobranca.ts.
  lateFinePct     Float @default(2)
  lateInterestPct Float @default(1)
  // Recebimento por Pix (estático, sem banco): a chave da transportadora e o
  // recebedor que vão no "Pix Copia e Cola" da fatura. Tudo nulo = sem Pix.
  // `pixKeyType`: CPF, CNPJ, EMAIL, TELEFONE, ALEATORIA. Ver src/lib/pix.ts.
  pixKeyType      String?
  pixKey          String?
  pixName         String?
  pixCity         String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  clients        Client[]
  drivers        Driver[]
  vehicles       Vehicle[]
  collections    Collection[]
  statusHistory  CollectionStatusHistory[]
  manifests      Manifest[]
  transactions   FinancialTransaction[]
  maintenances   Maintenance[]
  proofs         ProofOfDelivery[]
  quoteLeads     QuoteLead[]
  freightTables  FreightTable[]
  invoices       Invoice[]
  freightCities  FreightTableCity[]
  articles       Article[]
  socialPosts    SocialPost[]
  contentMetrics ContentMetric[]
  webhook        Webhook?
  outboxEvents   OutboxEvent[]
  fuelings       Fueling[]
  vehicleDocuments VehicleDocument[]
  tires          Tire[]
  vehicleChecklists VehicleChecklist[]
  occurrences    Occurrence[]
  occurrenceMessages OccurrenceMessage[]
  warehouseLocations WarehouseLocation[]
  collectionVolumes  CollectionVolume[]
  warehouseReceipts  WarehouseReceipt[]
  fiscalDocuments    FiscalDocument[]
  auditLogs          AuditLog[]
  helpers            Helper[]
  absences           Absence[]
  crewAdvances       CrewAdvance[]
  tripExpenses       TripExpense[]
  clientReceivers    ClientReceiver[]
}

model User {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id        String   @id @default(uuid())
  name      String
  email     String
  password  String
  role      Role     @default(CLIENT)
  clientId  String?  // Empresa que este usuário representa (obrigatório na prática quando role = CLIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // O que aconteceu com o convite por e-mail pedido ao login único
  // (ENVIADO | FALHOU | PENDENTE), o motivo e quando. O endereço de criar a
  // senha nunca é guardado. Ver src/lib/acessos.ts.
  inviteStatus String?
  inviteDetail String?
  inviteAt     DateTime?

  // Relations
  driver    Driver?
  client    Client?  @relation(fields: [clientId], references: [id])
  statusChanges CollectionStatusHistory[]
  proofsReviewed ProofOfDelivery[]
  vehicleChecklists VehicleChecklist[]
  occurrencesOpened   Occurrence[] @relation("OccurrenceOpenedBy")
  occurrencesAssigned Occurrence[] @relation("OccurrenceAssignee")
  occurrenceMessages  OccurrenceMessage[]
  volumesChecked      CollectionVolume[]
  warehouseReceipts   WarehouseReceipt[]
  fiscalDocuments     FiscalDocument[]
  auditLogs           AuditLog[]
  tripExpensesCreated  TripExpense[] @relation("TripExpenseCreatedBy")
  tripExpensesReviewed TripExpense[] @relation("TripExpenseReviewedBy")

  @@index([clientId])

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, email])
}

model Client {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id              String   @id @default(uuid())
  companyName     String   // Razão social
  tradeName       String?  // Nome fantasia
  cnpj            String
  ie              String?
  contactName     String?
  email           String?
  phone           String?
  address         String?
  paymentCondition String?
  creditLimit     Float?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  collections     Collection[]
  users           User[]
  transactions    FinancialTransaction[]

  invoices        Invoice[]
  occurrences     Occurrence[]
  receivers       ClientReceiver[]

  // Tabela de frete negociada com este cliente. Sem ela vale a padrão da transportadora.
  freightTableId  String?
  freightTable    FreightTable? @relation(fields: [freightTableId], references: [id], onDelete: SetNull)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, cnpj])
  @@index([freightTableId])
}

// ---------------------------------------------------------------------------
// Tabelas de frete
//
// Uma tabela tem as regras gerais (peso coberto pelo frete mínimo, valor do kg
// excedente, cubagem, limite de nota) e uma linha por cidade atendida, com o
// frete mínimo e o prazo de lá. A transportadora tem uma tabela padrão
// (`isDefault`) e pode ter tabelas negociadas, ligadas a clientes. Quem faz a
// conta é `calcularFrete` (src/lib/frete.ts).
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Faturamento
//
// A fatura cobra de um cliente o frete de cargas já entregues. O total é a soma
// dos fretes no momento da emissão e não muda depois. Emitir a fatura cria o
// lançamento a receber no financeiro (FinancialTransaction.invoiceId), que é o
// que o cliente vê no portal; pagar e cancelar andam juntos nos dois.
// ---------------------------------------------------------------------------
model Invoice {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id        String    @id @default(uuid())
  number    Int       // sequencial por empresa
  clientId  String
  status    String    @default("OPEN") // OPEN, PAID, CANCELLED
  total     Float
  dueDate   DateTime
  issuedAt  DateTime  @default(now())
  paidAt    DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  client      Client       @relation(fields: [clientId], references: [id])
  collections Collection[]
  transaction FinancialTransaction?

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, number])
  @@index([clientId])
}

// Destinatário frequente de um cliente: ele cadastra pelo portal e escolhe ao
// pedir coleta. Cada cliente só enxerga os seus (filtro por `clientId`).
model ClientReceiver {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String   @id @default(uuid())
  clientId    String
  name        String
  document    String?  // CNPJ ou CPF, só dígitos
  city        String   // cidade-UF, como vai no destino da coleta
  address     String?
  contactName String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([tenantId, clientId])
}

model FreightTable {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id               String    @id @default(uuid())
  name             String
  active           Boolean   @default(true)
  // A tabela usada quando o cliente não tem uma própria. No máximo uma por
  // empresa: a rota desmarca a anterior na mesma transação.
  isDefault        Boolean   @default(false)
  validFrom        DateTime?
  validTo          DateTime?

  includedWeightKg Float     @default(0) // peso coberto pelo frete mínimo da cidade
  excessPerKg      Float     @default(0) // R$ por kg acima do peso coberto
  cubageFactor     Float?    // kg por m³; nulo = não cubar
  invoiceLimit     Float?    // valor de nota coberto pelo frete; nulo = sem limite
  adValoremPct     Float?    // % sobre o que passa do limite; nulo = consultar o comercial
  maxVolumes       Int?      // acima disso a cotação sai com aviso
  redeliveryPct    Float?    // reentrega, % do frete original
  returnPct        Float?    // devolução, % do frete original
  notes            String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  cities           FreightTableCity[]
  clients          Client[]
  collections      Collection[]

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, name])
}

model FreightTableCity {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id            String   @id @default(uuid())
  tableId       String
  city          String   // como a transportadora escreveu
  cityKey       String   // sem acento, caixa nem pontuação: é por aqui que a cotação acha a cidade
  minimum       Float    // frete mínimo para esta cidade
  deadlineHours Int      @default(24)
  dedicated     Boolean  @default(false) // só com veículo dedicado: a cotação avisa

  table         FreightTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tableId, cityKey])
}

model Driver {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id        String   @id @default(uuid())
  userId    String   @unique
  cpf       String
  cnh       String
  cnhExpiry DateTime
  category  String
  phone     String?
  active    Boolean  @default(true)
  // Percentual do frete entregue que vira comissão. Nulo = sem comissão. Só o
  // administrador lê e altera (src/lib/equipe.ts).
  commissionPct Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  user      User      @relation(fields: [userId], references: [id])
  vehicles  Vehicle[]
  manifests Manifest[]
  collections Collection[]
  fuelings  Fueling[]
  absences  Absence[]
  advances  CrewAdvance[]

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, cpf])
}

model Vehicle {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id           String   @id @default(uuid())
  plate        String
  model        String
  type         String
  capacity     Float?
  maxWeight    Float?
  year         Int?
  driverId     String?
  status       String   @default("AVAILABLE") // AVAILABLE, ON_ROUTE, MAINTENANCE
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  driver       Driver?  @relation(fields: [driverId], references: [id])
  manifests    Manifest[]
  maintenances Maintenance[]
  fuelings     Fueling[]
  documents    VehicleDocument[]
  tires        Tire[]
  checklists   VehicleChecklist[]

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, plate])
}

model Collection {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String   @id @default(uuid())
  clientId    String
  sender      String
  receiver    String
  origin      String
  destination String
  volumes     Int
  weight      Float
  invoiceKey  String?
  invoiceValue Float?
  driverId    String?
  manifestId  String?
  // Ordem desta entrega na viagem (1, 2, 3...). Nulo = sem ordem definida: vai
  // para o fim, pela data de criação. Volta a nulo quando a carga sai da viagem.
  manifestSequence Int?
  status      String   @default("PENDING") // PENDING, CONFIRMED, COLLECTED, ROUTE, DELIVERED

  // Frete desta carga. Calculado pela tabela de frete quando a coleta nasce e
  // refeito quando destino, peso, volumes ou valor da nota mudam; se o operador
  // informar o valor à mão (`freightManual`), ele deixa de ser refeito. Nulo =
  // a cotar (sem tabela em vigor, ou cidade fora dela). Ver src/lib/frete-coleta.ts.
  freightValue         Float?
  freightDeadlineHours Int?
  freightManual        Boolean  @default(false)
  // Tabela que deu o valor, e a composição e os avisos da conta naquele momento.
  freightTableId       String?
  freightDetails       Json?
  freightTable         FreightTable? @relation(fields: [freightTableId], references: [id], onDelete: SetNull)

  // Fatura em que o frete desta carga foi cobrado. Uma carga entra em no
  // máximo uma fatura; cancelar a fatura solta a carga.
  invoiceId            String?
  invoice              Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  receiverName String?

  // Pedido de coleta: quando buscar, com que urgência e o que o motorista
  // precisa saber. Tudo opcional. `pickupDate` é um dia do calendário (meia-noite
  // UTC); a janela são horas do relógio ("08:00"). `cubicMeters` entra no frete
  // quando a tabela tem fator de cubagem. Ver src/lib/coletas.ts.
  pickupDate   DateTime?
  pickupFrom   String?
  pickupTo     String?
  priority     String   @default("NORMAL") // NORMAL, URGENT
  cubicMeters  Float?
  pickupNotes  String?

  // Codigo publico de rastreio: 10 digitos sorteados com CSPRNG (src/lib/tracking.ts).
  // E o segundo fator do rastreio publico, junto do CNPJ do cliente. Opcional no
  // schema porque as coletas criadas antes desta mudanca recebem o codigo por
  // backfill; toda coleta nova ja nasce com ele.
  trackingCode String?  @unique
  
  // CT-e
  cteKey      String?  @unique
  cteNumber   Int?
  cteStatus   String?  @default("PENDING") // PENDING, ISSUED, CANCELLED

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  client      Client   @relation(fields: [clientId], references: [id])
  driver      Driver?  @relation(fields: [driverId], references: [id])
  manifest    Manifest? @relation(fields: [manifestId], references: [id])
  statusHistory CollectionStatusHistory[]
  proof       ProofOfDelivery?
  quoteLead   QuoteLead?
  occurrences Occurrence[]
  volumeItems CollectionVolume[]
  warehouseReceipt WarehouseReceipt?
  fiscalDocuments FiscalDocument[]

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, clientId])
  @@index([tenantId, createdAt])
  @@index([manifestId])
  @@index([driverId])
  @@index([invoiceId])
}

// Uma linha por status que a coleta assumiu, com quando e quem. `fromStatus`
// e nulo na criacao. Quem grava e `recordStatusChanges` (src/lib/historico.ts)
// ou a criacao aninhada da propria coleta; coleta anterior a esta tabela fica
// sem historico, porque nao ha de onde tirar a data real de cada troca.
model CollectionStatusHistory {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id           String   @id @default(uuid())
  collectionId String
  fromStatus   String?
  toStatus     String
  userId       String?  // nulo quando a troca nao tem pessoa, ou o usuario foi apagado
  createdAt    DateTime @default(now())

  // Relations
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([collectionId, createdAt])

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}

model Manifest {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String   @id @default(uuid())
  driverId    String
  vehicleId   String
  status      String   @default("ASSEMBLING") // ASSEMBLING, ROUTE, FINISHED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Dados da viagem, todos opcionais (src/lib/viagem.ts). O hodômetro de saída
  // e o de retorno dão os km rodados; as previsões são só informação.
  helperId           String?
  departureOdometer  Int?
  returnOdometer     Int?
  plannedDepartureAt DateTime?
  plannedReturnAt    DateTime?
  notes              String?
  // Quando a saída foi liberada e quando a viagem foi finalizada. Nulos nas
  // viagens anteriores a estas colunas: para elas vale `createdAt` como saída
  // e `updatedAt` como finalização (`finalizadaNoPeriodo`).
  departedAt         DateTime?
  finishedAt         DateTime?

  // Relations
  driver      Driver    @relation(fields: [driverId], references: [id])
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id])
  helper      Helper?   @relation(fields: [helperId], references: [id], onDelete: SetNull)
  collections Collection[]
  advances    CrewAdvance[]
  expenses    TripExpense[]

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([tenantId, status])
}

model FinancialTransaction {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String   @id @default(uuid())
  type        String   // INCOME, EXPENSE
  amount      Float
  description String
  dueDate     DateTime?
  status      String   @default("PENDING") // PENDING, PAID
  clientId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Quando e como foi pago (ou recebido). `paidAt` é o que o fluxo de caixa
  // realizado usa; nulo enquanto o lançamento está em aberto.
  paidAt        DateTime?
  paymentMethod String?  // PIX, BOLETO, DINHEIRO, TRANSFERENCIA, CARTAO, OUTRO
  category      String?  // livre: combustível, manutenção, pedágio, folha…
  counterparty  String?  // fornecedor ou pagador que não é cliente cadastrado
  notes         String?
  costCenter    String?  // livre: filial, rota, veículo… Agrupa as despesas no relatório.

  // Baixa de título a receber com encargos. `amount` continua sendo o valor
  // original; `paidAmount` é o que entrou de fato (original + juros + multa −
  // desconto). Os quatro ficam nulos em aberto e na baixa pelo valor cheio.
  interest      Float?
  fine          Float?
  discount      Float?
  paidAmount    Float?

  // Lançamento gerado por uma fatura: nasce, é pago e some junto com ela.
  invoiceId   String?  @unique
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Relations
  client      Client?  @relation(fields: [clientId], references: [id])
  tripExpense TripExpense?

  @@index([clientId])

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}

model Maintenance {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String   @id @default(uuid())
  vehicleId   String
  description String
  cost        Float
  date        DateTime
  status      String   @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED
  // PREVENTIVE ou CORRECTIVE. Nulo nas manutenções anteriores a esta coluna.
  kind        String?
  odometer    Int?     // km no hodômetro quando o serviço foi feito
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Frota
//
// O que se registra de cada veículo além da manutenção: abastecimentos,
// documentos com vencimento, pneus e checklists. Consumo, custo por km e a
// situação de cada documento não são gravados: saem das contas de
// src/lib/frota.ts. A CNH do motorista (Driver.cnhExpiry) entra nos mesmos
// alertas de vencimento, lida de onde já está.
// ---------------------------------------------------------------------------

model Fueling {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id        String   @id @default(uuid())
  vehicleId String
  driverId  String?
  date      DateTime // dia do calendário, gravado à meia-noite UTC
  liters    Float
  totalCost Float
  odometer  Int      // km no hodômetro na hora de abastecer
  station   String?  // posto
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  driver    Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)
  // A despesa de viagem que gerou este abastecimento, quando ele nasceu de uma.
  tripExpense TripExpense?

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([vehicleId, date])
}

model VehicleDocument {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id        String   @id @default(uuid())
  vehicleId String
  type      String   // LICENSING, INSURANCE, ANTT, TACHOGRAPH, OTHER
  number    String?
  expiresAt DateTime // dia do calendário, gravado à meia-noite UTC
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([vehicleId])
  @@index([tenantId, expiresAt])
}

// Registro simples de pneu, sem estoque: onde está, desde quando e, quando
// sai, com quantos km saiu.
model Tire {
  tenantId    String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String   @id @default(uuid())
  vehicleId   String
  position    String   // livre: "Dianteiro esquerdo", "Eixo 2 direito interno"…
  brandModel  String
  installedAt DateTime // dia do calendário, gravado à meia-noite UTC
  installedKm Int
  removedKm   Int?     // nulo enquanto o pneu está no veículo
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([vehicleId])
}

model VehicleChecklist {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id        String   @id @default(uuid())
  vehicleId String
  // Quem fez: usuário do painel ou do motorista. Nulo se o usuário foi apagado.
  userId    String?
  date      DateTime @default(now()) // instante em que foi registrado
  odometer  Int?
  // Um booleano por item fixo (CHECKLIST_ITENS em src/lib/frota.ts): true = OK, false = problema.
  items     Json
  notes     String?
  createdAt DateTime @default(now())

  // Relations
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([vehicleId, date])
}

// ---------------------------------------------------------------------------
// Equipe (recursos humanos operacional)
//
// Quem vai para a estrada: o motorista (Driver, que já existia) e o ajudante
// (Helper, sem login). Ausência e adiantamento são de um ou de outro: uma das
// duas colunas (`driverId`, `helperId`) vem preenchida, nunca as duas. Quem
// está ausente num dia, a diferença do acerto e a comissão não são gravados:
// saem das contas de src/lib/equipe.ts.
// ---------------------------------------------------------------------------
model Helper {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id        String   @id @default(uuid())
  name      String
  cpf       String   // só dígitos
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  absences  Absence[]
  advances  CrewAdvance[]
  manifests Manifest[]

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, cpf])
}

model Absence {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id        String   @id @default(uuid())
  driverId  String?
  helperId  String?
  type      String   // VACATION, DAY_OFF, SICK_NOTE, MISSED, OTHER
  // Primeiro e último dia, os dois inclusive: dias do calendário, gravados à meia-noite UTC.
  startDate DateTime
  endDate   DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  driver    Driver?  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  helper    Helper?  @relation(fields: [helperId], references: [id], onDelete: Cascade)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([tenantId, startDate, endDate])
  @@index([driverId])
  @@index([helperId])
}

// Dinheiro entregue a quem vai viajar, e o acerto na volta. Registrar lança a
// despesa no Financeiro (categoria "Adiantamento"), como a manutenção faz.
model CrewAdvance {
  tenantId    String    @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String    @id @default(uuid())
  driverId    String?
  helperId    String?
  date        DateTime  // dia do calendário, gravado à meia-noite UTC
  amount      Float
  reason      String    // TRIP, VOUCHER, OTHER
  manifestId  String?   // a viagem do adiantamento, quando é de uma
  status      String    @default("OPEN") // OPEN, SETTLED
  // No acerto: quanto do adiantamento foi gasto com comprovante, e quando se acertou.
  spentAmount Float?
  settledAt   DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  driver      Driver?   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  helper      Helper?   @relation(fields: [helperId], references: [id], onDelete: Cascade)
  manifest    Manifest? @relation(fields: [manifestId], references: [id], onDelete: SetNull)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([driverId])
  @@index([helperId])
  @@index([manifestId])
}

// Comprovante da entrega de uma carga, registrado pelo motorista na baixa.
// A entrega e a propria carga (Collection): nao ha registro de entrega a parte.
// Despesa de uma viagem (pedágio, combustível, alimentação...), lançada pelo
// painel ou pelo motorista no aplicativo. Nasce pendente; o administrador
// aprova (e ela vira lançamento no Financeiro) ou recusa. Ver src/lib/viagem.ts.
model TripExpense {
  tenantId   String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id         String   @id @default(uuid())
  manifestId String
  type       String   // TOLL, FUEL, FOOD, LODGING, PARKING, MAINTENANCE, OTHER
  amount     Float
  date       DateTime // dia do calendário, gravado à meia-noite UTC
  notes      String?
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED
  // Quem lançou: é por aqui que o motorista só vê as dele.
  createdById String?
  // Quem aprovou ou recusou, e quando.
  reviewedById String?
  reviewedAt   DateTime?
  // Só no combustível: com litros e hodômetro a despesa gera o abastecimento
  // da frota (`fuelingId`), e o consumo do veículo sai dele.
  liters     Float?
  odometer   Int?
  fuelingId  String?  @unique
  // O lançamento que a aprovação criou no Financeiro.
  transactionId String? @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  manifest    Manifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation("TripExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy  User?    @relation("TripExpenseReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  fueling     Fueling? @relation(fields: [fuelingId], references: [id], onDelete: SetNull)
  transaction FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([manifestId])
  @@index([tenantId, status])
}

model ProofOfDelivery {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id              String   @id @default(uuid())
  collectionId    String   @unique
  photoBase64     String?  @db.Text
  signatureBase64 String?  @db.Text
  receiverName    String
  receiverDoc     String
  latitude        Float?
  longitude       Float?
  status          String   @default("SUBMITTED") // SUBMITTED, APPROVED, REJECTED
  // Conferência no painel: quem decidiu, quando e, na recusa, o motivo.
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  collection      Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  reviewedBy      User?      @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}

model QuoteLead {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id              String   @id @default(uuid())
  companyName     String
  email           String
  phone           String
  origin          String
  destination     String
  volumes         Int
  weight          Float
  estimatedValue  Float?
  // Valor da nota informado no pedido de cotação; segue para a coleta na conversão.
  invoiceValue    Float?
  status          String   @default("NEW") // NEW, CONTACTED, CONVERTED, LOST
  // Coleta criada na conversão do lead (src/lib/crm.ts). Uma coleta por lead.
  collectionId    String?  @unique
  collection      Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Atendimento e ocorrências
//
// Chamado de um cliente (aberto no portal) ou da equipe (painel, ou o motorista
// numa entrega) sobre uma carga ou sobre o serviço. O número é sequencial por
// empresa, como o da fatura. A conversa fica em OccurrenceMessage; a nota
// interna (`internal`) nunca vai para o portal. Regras em src/lib/ocorrencias.ts.
// ---------------------------------------------------------------------------
model Occurrence {
  tenantId     String    @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id           String    @id @default(uuid())
  number       Int       // sequencial por empresa
  type         String    // DELAY, DAMAGE, LOSS, BILLING, REDELIVERY, OTHER
  title        String
  description  String    @db.Text
  status       String    @default("OPEN") // OPEN, ANALYSIS, IN_PROGRESS, RESOLVED, CLOSED
  priority     String    @default("NORMAL") // LOW, NORMAL, HIGH
  // A carga de que o chamado trata, quando trata de uma.
  collectionId String?
  // O cliente a quem o chamado pertence: é por aqui que o portal filtra. Nulo = chamado só da equipe.
  clientId     String?
  // Quem abriu, e de que lado: CLIENT (portal) ou STAFF (painel ou motorista).
  openedById   String?
  origin       String    @default("STAFF")
  // Quem da equipe cuida do chamado.
  assigneeId   String?
  openedAt     DateTime  @default(now())
  resolvedAt   DateTime?
  closedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  client       Client?     @relation(fields: [clientId], references: [id])
  openedBy     User?       @relation("OccurrenceOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  assignee     User?       @relation("OccurrenceAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages     OccurrenceMessage[]

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([clientId])
  @@index([collectionId])
}

// Andamento do chamado, em ordem cronológica.
model OccurrenceMessage {
  tenantId     String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id           String   @id @default(uuid())
  occurrenceId String
  authorId     String?  // nulo se o usuário foi apagado
  // De que lado veio, gravado na hora: o perfil do autor pode mudar depois.
  fromClient   Boolean  @default(false)
  // Nota interna: só a equipe lê. O portal nunca recebe estas linhas.
  internal     Boolean  @default(false)
  body         String   @db.Text
  createdAt    DateTime @default(now())

  // Relations
  occurrence   Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  author       User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([occurrenceId, createdAt])
}

// ---------------------------------------------------------------------------
// Recebimento, conferência e depósito
//
// A carga (Collection) diz quantos volumes tem. Cada volume ganha uma linha em
// CollectionVolume quando é conferido no depósito: recebido, avariado ou
// faltando. O código do volume é o código de rastreio da carga mais a
// sequência ("1234567890-02"); enquanto o volume não foi conferido ele não tem
// linha, e o código sai da conta (src/lib/deposito.ts), que é o que a etiqueta
// imprime. WarehouseReceipt é a conferência concluída da carga: quem, quando e
// as divergências encontradas. WarehouseLocation é a posição no depósito.
// ---------------------------------------------------------------------------
model WarehouseLocation {
  tenantId    String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String   @id @default(uuid())
  // Código curto, em maiúsculas, como está escrito na prateleira: "A-01-03".
  code        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  volumes     CollectionVolume[]

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, code])
}

model CollectionVolume {
  tenantId     String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id           String   @id @default(uuid())
  collectionId String
  sequence     Int      // 1 até Collection.volumes
  code         String   // código de rastreio + "-" + sequência
  status       String   @default("RECEIVED") // RECEIVED, DAMAGED, MISSING
  weight       Float?   // peso conferido, em kg
  damageNote   String?  // o que há de errado, quando avariado
  locationId   String?  // posição no depósito
  checkedAt    DateTime @default(now())
  checkedById  String?  // nulo se o usuário foi apagado
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  collection   Collection         @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  location     WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  checkedBy    User?              @relation(fields: [checkedById], references: [id], onDelete: SetNull)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, code])
  @@unique([collectionId, sequence])
  @@index([locationId])
}

// A conferência concluída de uma carga. Os números são os do momento em que
// foi concluída, e são refeitos se um volume mudar depois (um faltante que
// apareceu). Peso conferido é nulo quando nem todo volume presente foi pesado.
model WarehouseReceipt {
  tenantId        String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id              String   @id @default(uuid())
  collectionId    String   @unique
  userId          String?  // quem concluiu; nulo se o usuário foi apagado
  concludedAt     DateTime @default(now())
  expectedVolumes Int      // o declarado na carga
  receivedVolumes Int      // presentes sem avaria
  damagedVolumes  Int      // presentes com avaria
  missingVolumes  Int
  declaredWeight  Float
  checkedWeight   Float?
  quantityDivergence Boolean @default(false)
  weightDivergence   Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  collection      Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user            User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}

// Nota fiscal eletrônica (NF-e, modelo 55) importada pelo XML. Guarda o que o
// leitor extraiu (src/lib/nfe.ts) e o XML original, como chegou. A chave de
// acesso é única por empresa: a mesma nota não entra duas vezes. A carga é
// opcional: a nota pode ser importada antes de existir carga para ela.
model FiscalDocument {
  tenantId        String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id              String   @id @default(uuid())
  accessKey       String   // 44 dígitos, com o dígito verificador conferido
  number          Int
  series          Int
  issuedAt        DateTime?
  operationNature String?
  // 0 = frete por conta do emitente, 1 = do destinatário (campo modFrete da nota).
  freightMode     Int?

  issuerTaxId     String   // CNPJ ou CPF, só dígitos
  issuerName      String
  issuerCity      String?
  issuerState     String?
  issuerAddress   String?

  recipientTaxId  String?
  recipientName   String?
  recipientCity   String?
  recipientState  String?
  recipientAddress String?

  totalValue      Float    // vNF
  grossWeight     Float?   // soma de transp/vol/pesoB
  volumes         Int?     // soma de transp/vol/qVol

  xml             String   @db.Text

  collectionId    String?
  importedById    String?  // quem importou; nulo se o usuário foi apagado
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  collection      Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  importedBy      User?       @relation(fields: [importedById], references: [id], onDelete: SetNull)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, accessKey])
  @@index([tenantId, createdAt])
  @@index([collectionId])
}

// ---------------------------------------------------------------------------
// Conteúdo e distribuição
//
// A matéria do blog continua sendo escrita em src/content/blog.ts, que é quem
// gera a página, o sitemap e os dados estruturados. O banco não duplica o texto:
// ele registra que a matéria existe (Article) e guarda o que interessa depois de
// publicada, que é para onde ela foi (SocialPost) e quanto rendeu (ContentMetric).
//
// O mesmo SocialPost serve blog, Instagram, Google Meu Negócio e o resto: o que
// muda entre eles é o canal e o formato do texto, não o ciclo de vida. Por isso
// há uma tabela só, com canal como campo, em vez de uma tabela por rede.
// ---------------------------------------------------------------------------

enum Channel {
  BLOG
  INSTAGRAM
  GOOGLE_BUSINESS
  FACEBOOK
  LINKEDIN
  WHATSAPP_STATUS
}

enum PostStatus {
  DRAFT     // escrito, ninguém aprovou
  APPROVED  // liberado pelo comercial, esperando a hora
  SCHEDULED // tem data marcada
  PUBLISHED // saiu
  FAILED    // tentou sair e a API recusou
  CANCELED  // desistiu-se antes de publicar
}

model Article {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String   @id @default(uuid())
  slug        String   @unique // o mesmo slug de src/content/blog.ts
  title       String
  description String
  category    String
  publishedAt DateTime
  // Espelho do que está no arquivo, para o painel mostrar sem ler o bundle.
  // A página do site nunca lê daqui: quem manda é o blog.ts.
  syncedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  posts       SocialPost[]
  metrics     ContentMetric[]

  @@index([publishedAt])

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}

model SocialPost {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String     @id @default(uuid())
  channel     Channel
  status      PostStatus @default(DRAFT)

  // O texto que vai para a rede. Cada canal tem o seu, porque a legenda do
  // Instagram não é o resumo do Google Meu Negócio.
  body        String     @db.Text
  imageUrl    String?
  linkUrl     String?    // para onde o post aponta: a matéria, a cotação, o site

  articleId   String?    // post que divulga uma matéria; nulo quando é post avulso
  scheduledFor DateTime? // quando deve sair
  publishedAt DateTime?  // quando saiu de fato

  // Devolvido pela API da rede no momento em que o post sai. Guardado para
  // conseguir achar o post de volta e para não republicar o mesmo duas vezes.
  externalId  String?
  externalUrl String?

  // Preenchido só quando status = FAILED. Erro sem texto vira falha invisível,
  // e falha invisível é a que ninguém conserta.
  failureReason String?  @db.Text
  attempts    Int        @default(0)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  article     Article?   @relation(fields: [articleId], references: [id])

  // O mesmo post não sai duas vezes no mesmo canal, nem quando o fluxo do n8n
  // repete a chamada.
  @@unique([channel, externalId])
  @@index([status, scheduledFor])
  @@index([articleId])

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}

model ContentMetric {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String   @id @default(uuid())
  articleId   String
  measuredOn  DateTime @db.Date // a data da medição, não o instante

  // Search Console, últimos 28 dias na data da medição.
  impressions Int      @default(0)
  clicks      Int      @default(0)
  position    Float?
  ctr         Float?

  createdAt   DateTime @default(now())

  // Relations
  article     Article  @relation(fields: [articleId], references: [id])

  // Uma medição por matéria por dia: rodar o fluxo duas vezes na mesma terça
  // não pode dobrar o número.
  @@unique([articleId, measuredOn])
  @@index([measuredOn])

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Eventos para sistemas de fora (n8n e afins)
//
// A empresa cadastra um endereço (Webhook). A partir daí, cada troca de status
// de carga vira uma linha em OutboxEvent, gravada por gatilho na mesma
// transação da troca (prisma/sql/010-rls.sql): evento não se perde nem sai sem
// a troca ter acontecido. Quem entrega é src/lib/eventos.ts, com assinatura e
// novas tentativas. Empresa sem Webhook não gera evento.
// ---------------------------------------------------------------------------

model Webhook {
  tenantId  String   @unique @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id        String   @id @default(uuid())
  url       String
  // Segredo da assinatura (HMAC-SHA256 do corpo). Mostrado uma vez, ao ser criado.
  secret    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
}

model OutboxEvent {
  tenantId      String    @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id            String    @id @default(uuid())
  type          String    // coleta.status, fatura.emitida|paga|reaberta|cancelada, cobranca.vencida, ocorrencia.aberta|status, teste
  payload       Json
  createdAt     DateTime  @default(now())
  // Próxima tentativa de entrega. Cada tentativa empurra para a frente (1, 2, 4... minutos).
  nextAttemptAt DateTime  @default(now())
  attempts      Int       @default(0)
  deliveredAt   DateTime?
  lastError     String?
  // Evento que só pode existir uma vez (o aviso de um título vencido): a chave repetida é ignorada.
  dedupeKey     String?   @unique

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId, createdAt])
  @@index([deliveredAt, nextAttemptAt])
}

// ---------------------------------------------------------------------------
// Auditoria
//
// Uma linha por ação importante (quem, quando, de onde, o que mudou). Só
// inserção: o papel da aplicação não tem UPDATE nem DELETE nesta tabela
// (prisma/sql/010-rls.sql). O nome e o perfil de quem fez ficam copiados na
// linha, porque o usuário pode ser apagado depois. Ver src/lib/auditoria.ts.
// ---------------------------------------------------------------------------
model AuditLog {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String?  // nulo se o usuário foi apagado depois
  userName  String
  userRole  String?
  action    String   // texto curto e estável: cliente.criar, fatura.pagar, usuario.perfil...
  entity    String   // cliente, fatura, usuario...
  entityId  String?
  summary   String   // frase em português, para a lista
  before    Json?    // só os campos que mudaram, sem segredo nem imagem
  after     Json?
  ip        String?
  device    String?  // resumo do navegador e do aparelho

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@index([userId])
}
