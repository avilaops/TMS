generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OPERATION
  DRIVER
  CLIENT
}

// ---------------------------------------------------------------------------
// Multi-tenant
//
// Cada transportadora que usa o sistema e um Tenant. Toda tabela de negocio
// carrega `tenantId`, e quem separa uma empresa da outra e o proprio Postgres:
// as politicas de seguranca por linha (prisma/sql/010-rls.sql) so mostram as
// linhas do tenant gravado em `app.tenant_id` na transacao. O codigo nao
// preenche `tenantId` na mao: o valor padrao da coluna le essa mesma variavel,
// e sem ela o INSERT falha. Ver src/lib/prisma.ts.
// ---------------------------------------------------------------------------
model Tenant {
  id        String   @id @default(uuid())
  // Identificador curto e estavel (URL, integracoes). So letras minusculas, numeros e hifen.
  slug      String   @unique
  name      String
  cnpj      String?  @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  clients        Client[]
  drivers        Driver[]
  vehicles       Vehicle[]
  collections    Collection[]
  statusHistory  CollectionStatusHistory[]
  manifests      Manifest[]
  transactions   FinancialTransaction[]
  maintenances   Maintenance[]
  proofs         ProofOfDelivery[]
  quoteLeads     QuoteLead[]
  freightTables  FreightTable[]
  freightCities  FreightTableCity[]
  articles       Article[]
  socialPosts    SocialPost[]
  contentMetrics ContentMetric[]
}

model User {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id        String   @id @default(uuid())
  name      String
  email     String
  password  String
  role      Role     @default(CLIENT)
  clientId  String?  // Empresa que este usuário representa (obrigatório na prática quando role = CLIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  driver    Driver?
  client    Client?  @relation(fields: [clientId], references: [id])
  statusChanges CollectionStatusHistory[]
  proofsReviewed ProofOfDelivery[]

  @@index([clientId])

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, email])
}

model Client {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id              String   @id @default(uuid())
  companyName     String   // Razão social
  tradeName       String?  // Nome fantasia
  cnpj            String
  ie              String?
  contactName     String?
  email           String?
  phone           String?
  address         String?
  paymentCondition String?
  creditLimit     Float?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  collections     Collection[]
  users           User[]
  transactions    FinancialTransaction[]

  // Tabela de frete negociada com este cliente. Sem ela vale a padrão da transportadora.
  freightTableId  String?
  freightTable    FreightTable? @relation(fields: [freightTableId], references: [id], onDelete: SetNull)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, cnpj])
  @@index([freightTableId])
}

// ---------------------------------------------------------------------------
// Tabelas de frete
//
// Uma tabela tem as regras gerais (peso coberto pelo frete mínimo, valor do kg
// excedente, cubagem, limite de nota) e uma linha por cidade atendida, com o
// frete mínimo e o prazo de lá. A transportadora tem uma tabela padrão
// (`isDefault`) e pode ter tabelas negociadas, ligadas a clientes. Quem faz a
// conta é `calcularFrete` (src/lib/frete.ts).
// ---------------------------------------------------------------------------
model FreightTable {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id               String    @id @default(uuid())
  name             String
  active           Boolean   @default(true)
  // A tabela usada quando o cliente não tem uma própria. No máximo uma por
  // empresa: a rota desmarca a anterior na mesma transação.
  isDefault        Boolean   @default(false)
  validFrom        DateTime?
  validTo          DateTime?

  includedWeightKg Float     @default(0) // peso coberto pelo frete mínimo da cidade
  excessPerKg      Float     @default(0) // R$ por kg acima do peso coberto
  cubageFactor     Float?    // kg por m³; nulo = não cubar
  invoiceLimit     Float?    // valor de nota coberto pelo frete; nulo = sem limite
  adValoremPct     Float?    // % sobre o que passa do limite; nulo = consultar o comercial
  maxVolumes       Int?      // acima disso a cotação sai com aviso
  redeliveryPct    Float?    // reentrega, % do frete original
  returnPct        Float?    // devolução, % do frete original
  notes            String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  cities           FreightTableCity[]
  clients          Client[]

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, name])
}

model FreightTableCity {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id            String   @id @default(uuid())
  tableId       String
  city          String   // como a transportadora escreveu
  cityKey       String   // sem acento, caixa nem pontuação: é por aqui que a cotação acha a cidade
  minimum       Float    // frete mínimo para esta cidade
  deadlineHours Int      @default(24)
  dedicated     Boolean  @default(false) // só com veículo dedicado: a cotação avisa

  table         FreightTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tableId, cityKey])
}

model Driver {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id        String   @id @default(uuid())
  userId    String   @unique
  cpf       String
  cnh       String
  cnhExpiry DateTime
  category  String
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  user      User      @relation(fields: [userId], references: [id])
  vehicles  Vehicle[]
  manifests Manifest[]
  collections Collection[]

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, cpf])
}

model Vehicle {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id           String   @id @default(uuid())
  plate        String
  model        String
  type         String
  capacity     Float?
  maxWeight    Float?
  year         Int?
  driverId     String?
  status       String   @default("AVAILABLE") // AVAILABLE, ON_ROUTE, MAINTENANCE
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  driver       Driver?  @relation(fields: [driverId], references: [id])
  manifests    Manifest[]
  maintenances Maintenance[]

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@unique([tenantId, plate])
}

model Collection {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String   @id @default(uuid())
  clientId    String
  sender      String
  receiver    String
  origin      String
  destination String
  volumes     Int
  weight      Float
  invoiceKey  String?
  invoiceValue Float?
  driverId    String?
  manifestId  String?
  status      String   @default("PENDING") // PENDING, CONFIRMED, COLLECTED, ROUTE, DELIVERED
  receiverName String?

  // Codigo publico de rastreio: 10 digitos sorteados com CSPRNG (src/lib/tracking.ts).
  // E o segundo fator do rastreio publico, junto do CNPJ do cliente. Opcional no
  // schema porque as coletas criadas antes desta mudanca recebem o codigo por
  // backfill; toda coleta nova ja nasce com ele.
  trackingCode String?  @unique
  
  // CT-e
  cteKey      String?  @unique
  cteNumber   Int?
  cteStatus   String?  @default("PENDING") // PENDING, ISSUED, CANCELLED

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  client      Client   @relation(fields: [clientId], references: [id])
  driver      Driver?  @relation(fields: [driverId], references: [id])
  manifest    Manifest? @relation(fields: [manifestId], references: [id])
  statusHistory CollectionStatusHistory[]
  proof       ProofOfDelivery?

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, clientId])
  @@index([tenantId, createdAt])
  @@index([manifestId])
  @@index([driverId])
}

// Uma linha por status que a coleta assumiu, com quando e quem. `fromStatus`
// e nulo na criacao. Quem grava e `recordStatusChanges` (src/lib/historico.ts)
// ou a criacao aninhada da propria coleta; coleta anterior a esta tabela fica
// sem historico, porque nao ha de onde tirar a data real de cada troca.
model CollectionStatusHistory {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id           String   @id @default(uuid())
  collectionId String
  fromStatus   String?
  toStatus     String
  userId       String?  // nulo quando a troca nao tem pessoa, ou o usuario foi apagado
  createdAt    DateTime @default(now())

  // Relations
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([collectionId, createdAt])

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}

model Manifest {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String   @id @default(uuid())
  driverId    String
  vehicleId   String
  status      String   @default("ASSEMBLING") // ASSEMBLING, ROUTE, FINISHED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  driver      Driver    @relation(fields: [driverId], references: [id])
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id])
  collections Collection[]

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
  @@index([tenantId, status])
}

model FinancialTransaction {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String   @id @default(uuid())
  type        String   // INCOME, EXPENSE
  amount      Float
  description String
  dueDate     DateTime?
  status      String   @default("PENDING") // PENDING, PAID
  clientId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  client      Client?  @relation(fields: [clientId], references: [id])

  @@index([clientId])

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}

model Maintenance {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String   @id @default(uuid())
  vehicleId   String
  description String
  cost        Float
  date        DateTime
  status      String   @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}

// Comprovante da entrega de uma carga, registrado pelo motorista na baixa.
// A entrega e a propria carga (Collection): nao ha registro de entrega a parte.
model ProofOfDelivery {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id              String   @id @default(uuid())
  collectionId    String   @unique
  photoBase64     String?  @db.Text
  signatureBase64 String?  @db.Text
  receiverName    String
  receiverDoc     String
  latitude        Float?
  longitude       Float?
  status          String   @default("SUBMITTED") // SUBMITTED, APPROVED, REJECTED
  // Conferência no painel: quem decidiu, quando e, na recusa, o motivo.
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  collection      Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  reviewedBy      User?      @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}

model QuoteLead {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id              String   @id @default(uuid())
  companyName     String
  email           String
  phone           String
  origin          String
  destination     String
  volumes         Int
  weight          Float
  estimatedValue  Float?
  status          String   @default("NEW") // NEW, CONTACTED, CONVERTED, LOST
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Conteúdo e distribuição
//
// A matéria do blog continua sendo escrita em src/content/blog.ts, que é quem
// gera a página, o sitemap e os dados estruturados. O banco não duplica o texto:
// ele registra que a matéria existe (Article) e guarda o que interessa depois de
// publicada, que é para onde ela foi (SocialPost) e quanto rendeu (ContentMetric).
//
// O mesmo SocialPost serve blog, Instagram, Google Meu Negócio e o resto: o que
// muda entre eles é o canal e o formato do texto, não o ciclo de vida. Por isso
// há uma tabela só, com canal como campo, em vez de uma tabela por rede.
// ---------------------------------------------------------------------------

enum Channel {
  BLOG
  INSTAGRAM
  GOOGLE_BUSINESS
  FACEBOOK
  LINKEDIN
  WHATSAPP_STATUS
}

enum PostStatus {
  DRAFT     // escrito, ninguém aprovou
  APPROVED  // liberado pelo comercial, esperando a hora
  SCHEDULED // tem data marcada
  PUBLISHED // saiu
  FAILED    // tentou sair e a API recusou
  CANCELED  // desistiu-se antes de publicar
}

model Article {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String   @id @default(uuid())
  slug        String   @unique // o mesmo slug de src/content/blog.ts
  title       String
  description String
  category    String
  publishedAt DateTime
  // Espelho do que está no arquivo, para o painel mostrar sem ler o bundle.
  // A página do site nunca lê daqui: quem manda é o blog.ts.
  syncedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  posts       SocialPost[]
  metrics     ContentMetric[]

  @@index([publishedAt])

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}

model SocialPost {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String     @id @default(uuid())
  channel     Channel
  status      PostStatus @default(DRAFT)

  // O texto que vai para a rede. Cada canal tem o seu, porque a legenda do
  // Instagram não é o resumo do Google Meu Negócio.
  body        String     @db.Text
  imageUrl    String?
  linkUrl     String?    // para onde o post aponta: a matéria, a cotação, o site

  articleId   String?    // post que divulga uma matéria; nulo quando é post avulso
  scheduledFor DateTime? // quando deve sair
  publishedAt DateTime?  // quando saiu de fato

  // Devolvido pela API da rede no momento em que o post sai. Guardado para
  // conseguir achar o post de volta e para não republicar o mesmo duas vezes.
  externalId  String?
  externalUrl String?

  // Preenchido só quando status = FAILED. Erro sem texto vira falha invisível,
  // e falha invisível é a que ninguém conserta.
  failureReason String?  @db.Text
  attempts    Int        @default(0)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  article     Article?   @relation(fields: [articleId], references: [id])

  // O mesmo post não sai duas vezes no mesmo canal, nem quando o fluxo do n8n
  // repete a chamada.
  @@unique([channel, externalId])
  @@index([status, scheduledFor])
  @@index([articleId])

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}

model ContentMetric {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text)"))
  id          String   @id @default(uuid())
  articleId   String
  measuredOn  DateTime @db.Date // a data da medição, não o instante

  // Search Console, últimos 28 dias na data da medição.
  impressions Int      @default(0)
  clicks      Int      @default(0)
  position    Float?
  ctr         Float?

  createdAt   DateTime @default(now())

  // Relations
  article     Article  @relation(fields: [articleId], references: [id])

  // Uma medição por matéria por dia: rodar o fluxo duas vezes na mesma terça
  // não pode dobrar o número.
  @@unique([articleId, measuredOn])
  @@index([measuredOn])

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId])
}
